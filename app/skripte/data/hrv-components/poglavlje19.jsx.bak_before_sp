      <!-- 7. JEDNAČENJE PO ZVUČNOSTI -->
      <div class="scene-card" onclick="togScene(this)">
        <div class="scene-head">
          <div class="scene-badge" style="background:#e67e22;color:#fff">7</div>
          <div class="scene-ttl">
