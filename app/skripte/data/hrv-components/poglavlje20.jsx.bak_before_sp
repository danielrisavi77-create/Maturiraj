          <tr><td><strong>Svršeni</strong> (perf.)</td><td>radnja završena, jednokratna</td><td>napisati, pročitati, dotrčati, prespavati</td><td>s prefiksom: na-, pro-, do-, pre-, iz-, u-, za-, po-</td></tr>
        </tbody>
      </table>

