export default function H08Chapter() {
  useEffect(() => {
    let root3 = null;
    let roots = [];

    const mountPortal = (id, el) => {
      const div = document.getElementById(id);
      if (!div) return null;
      const r = createRoot(div);
      r.render(el);
      return r;
    };

    // ChapterWrapper injects HTML via dangerouslySetInnerHTML in its own useEffect.
    // We defer one rAF so the DOM is fully painted before querying portal targets.
    const raf = requestAnimationFrame(() => {
      const l3 = document.getElementById('l3');
      if (l3) {
        root3 = createRoot(l3);
        root3.render(
          <CitatnikH08
            onBack={() => typeof window.sw === 'function' && window.sw(2)}
            onNext={() => typeof window.sw === 'function' && window.sw(4)}
          />
        );
      }

      roots = [
        mountPortal('h08c-compare-moderna-realizam', <CompareModernaRealizam />),
        mountPortal('h08c-author-kafka-l0',          <AuthorCardKafka context="l0" />),
        mountPortal('h08c-timeline-kafka',           <TimelineKafka />),
        mountPortal('h08c-popkultura-kafka',         <PopKulturaKafka />),
        mountPortal('h08c-hero-quote',               <HeroQuotePreobrazaj />),
        mountPortal('h08c-stat-cards',               <StatCardsPreobrazaj />),
        mountPortal('h08c-simboli-grid',             <SimboliGridPreobrazaj />),
        mountPortal('h08c-compare-kafka-dost',       <CompareKafkaDostojevski />),
        mountPortal('h08c-accordion-teze',           <AccordionEsejTezeH08 />),
      ];
    });

    return () => {
      cancelAnimationFrame(raf);
      root3?.unmount();
      roots.forEach(r => r?.unmount());
    };
  }, []);

  return (
    <ChapterWrapper
      chapterId="H08"
      bodyHtml={BODY_HTML}
      stylesCss={STYLES_CSS}
      scriptsJs={SCRIPTS_JS}
