function App(){
  const[screen,setScreen]=useState("home");
  const[examKey,setExamKey]=useState("2024_ljeto_A");
  const[pendingExamKey,setPendingExamKey]=useState("2024_ljeto_A");
  const[prevScreen,setPrevScreen]=useState("home");
  const[soundOn,setSoundOn]=useState(()=>{try{return localStorage.getItem("discere_sound")!=="0";}catch(e){return true;}});
  window._soundOn=soundOn;
  const[showDisclaimer,setShowDisclaimer]=useState(false);
  const[darkMode,setDarkMode]=useState(()=>localStorage.getItem("discere_hrv_dark")==="1");
  const[userData,updateUserData]=useUserData();

  useEffect(()=>{
    window.__discereSetHrvDark?.(darkMode);
    try{localStorage.setItem("discere_hrv_dark",darkMode?"1":"0");}catch(e){}
  },[darkMode]);
  useEffect(()=>{
    try{localStorage.setItem("discere_sound",soundOn?"1":"0");}catch(e){}
    window._soundOn=soundOn;
  },[darkMode]);

  function goHome(){setScreen("home");window.scrollTo(0,0);}
  function goModeSelect(k){setPendingExamKey(k);setScreen("modeselect");window.scrollTo(0,0);}
  function goPractice(k){setExamKey(k||"2024_ljeto_A");setScreen("practice");window.scrollTo(0,0);}
  function goExamMode(k){setExamKey(k||pendingExamKey||"2024_ljeto_A");setScreen("exammode");window.scrollTo(0,0);}
  function goFilter(){setScreen("filter");window.scrollTo(0,0);}
  function goFilterSession(ve){window._virtualExam=ve;setScreen("filter_session");window.scrollTo(0,0);}
  function goErrors(){setScreen("errors");window.scrollTo(0,0);}
  function goErrorSession(ve){window._virtualExam=ve;setScreen("errors_session");window.scrollTo(0,0);}
  function goBookmarks(){setScreen("bookmarks");window.scrollTo(0,0);}
  function goBookmarkSession(ve){window._virtualExam=ve;setScreen("bookmark_session");window.scrollTo(0,0);}
  function goStats(){setScreen("stats");window.scrollTo(0,0);}
  function goBrowse(){setScreen("browse");window.scrollTo(0,0);}
  function goEsejList(){setScreen("esej_list");window.scrollTo(0,0);}
    function goSazetakList(){setScreen("sazeci_list");window.scrollTo(0,0);}
    function goSazetak(k){setSazetakKey(k);setScreen("sazetak");window.scrollTo(0,0);}
  const[esejKey,setEsejKey]=useState(null);
  const[sazetakKey,setSazetakKey]=useState(null);
  function goEsej(key){setEsejKey(key);setScreen("esej");window.scrollTo(0,0);}
  function goPracticeExamErrors(wrongQs,srcExam){
    const ve={key:"exam_errors_session",year:srcExam.year,season:srcExam.season,label:srcExam.label+" â€” GreĹˇke",qs:[...wrongQs].sort(()=>Math.random()-.5)};
    window._virtualExam=ve;setScreen("errors_session");window.scrollTo(0,0);
  }

  function onExamDone(result){
    const xpGain=calcXpGain(result.pct,result.total);
    const examQs=EXAMS[result.examKey]?.qs||[];
    const wrongAnswers=[];
    // topic breakdown za analytics
    const topicBreakdown={};
    examQs.forEach(q=>{
      if(q.type!=="mc") return;
      const topic=q.topic||"ostalo";
      if(!topicBreakdown[topic]) topicBreakdown[topic]={correct:0,total:0};
      topicBreakdown[topic].total++;
      if(chk(q,result.answers?.[q.id])===true) topicBreakdown[topic].correct++;
      if(chk(q,result.answers?.[q.id])===false){
        wrongAnswers.push({qid:q.id,q:q.q.slice(0,80),topic,examKey:result.examKey,type:q.type});
      }
    });
    updateUserData(prev=>{
      const updated=updateStreak(prev);
      const errorTracker={...(prev.errorTracker||{})};
      wrongAnswers.forEach(w=>{
        const key=w.examKey+"_"+w.qid;
        const ex=errorTracker[key]||{count:0,q:w.q,topic:w.topic,examKey:w.examKey,qid:w.qid};
        errorTracker[key]={...ex,count:ex.count+1,lastDate:new Date().toLocaleDateString("hr")};
      });
      examQs.forEach(q=>{
        if(q.type!=="mc") return;
        if(chk(q,result.answers?.[q.id])===true){
          const key=result.examKey+"_"+q.id;
          if(errorTracker[key]){errorTracker[key]={...errorTracker[key],count:Math.max(0,errorTracker[key].count-1)};if(errorTracker[key].count===0)delete errorTracker[key];}
        }
      });
      const newHistory=[...(prev.history||[]),{
        examLabel:result.examLabel,examKey:result.examKey,
        date:new Date().toLocaleDateString("hr"),pct:result.pct,grade:result.grade,
        cor:result.cor,total:result.total,qTimes:result.qTimes||{},
        mode:result.examMode?"simulacija":"vjeĹľbanje",
        topic_breakdown:topicBreakdown,
        answers:result.answers||{}
      }];
      return{...updated,xp:(prev.xp||0)+xpGain,history:newHistory,errorTracker,totalExams:(prev.totalExams||0)+1};
    });
  }



  const exam=EXAMS[examKey];
  const activeExam=(screen==="filter_session"||screen==="errors_session"||screen==="bookmark_session")?window._virtualExam||exam:exam;

  const toggles=e("div",{style:{display:"flex",gap:6,marginLeft:"auto"}},
    e("button",{onClick:()=>setShowDisclaimer(true),title:"O aplikaciji",
      style:{background:"none",border:"1px solid var(--bdr)",borderRadius:"var(--r)",padding:"4px 8px",cursor:"pointer",fontSize:14,color:"var(--muted)"}},
      "â„ąď¸Ź"),
    e("button",{onClick:()=>setSoundOn(s=>!s),title:soundOn?"IskljuÄŤi zvuk":"UkljuÄŤi zvuk",
      style:{background:"none",border:"1px solid var(--bdr)",borderRadius:"var(--r)",padding:"4px 8px",cursor:"pointer",fontSize:14,color:soundOn?"var(--text)":"var(--muted)"}},
      soundOn?"đź”Š":"đź”‡"),
    e("button",{onClick:()=>{setPrevScreen(screen);setScreen("upute");},title:"Upute za koriĹˇtenje",
      style:{background:"none",border:"1px solid var(--bdr)",borderRadius:"var(--r)",padding:"4px 10px",cursor:"pointer",fontSize:13,color:"var(--muted)",display:"flex",alignItems:"center",gap:5}},
      "đź“–",e("span",{style:{fontSize:12,fontWeight:600}},"Upute")),
    e("button",{onClick:()=>setDarkMode(d=>!d),title:darkMode?"Svijetli mod":"Tamni mod",
      style:{background:"none",border:"1px solid var(--bdr)",borderRadius:"var(--r)",padding:"4px 8px",cursor:"pointer",fontSize:14,color:"var(--muted)"}},
      darkMode?"â€ď¸Ź":"đźŚ™")
  );

  return e("div",{style:{minHeight:"100vh",background:"var(--bg)",color:"var(--text)"}},
    showDisclaimer&&e(DisclaimerModal,{onClose:()=>setShowDisclaimer(false)}),
    screen==="upute"&&e(UputeModal,{onClose:()=>{setScreen(prevScreen);window.scrollTo(0,0);}}),
    screen==="home"&&e(Home,{onExam:goModeSelect,onPractice:goPractice,onFilter:goFilter,onErrors:goErrors,onBookmarks:goBookmarks,onStats:goStats,onBrowse:goBrowse,onEsej:goEsejList,onSazetak:goSazetakList,onShowDisclaimer:()=>setShowDisclaimer(true),userData,toggles}),
    screen==="modeselect"&&e(ModeSelect,{examKey:pendingExamKey,onExamMode:goExamMode,onPractice:goPractice,onBack:goHome,onEsej:goEsej,onSazetak:goSazetak}),
    screen==="filter"&&e(TopicFilterScreen,{onStart:goFilterSession,onBack:goHome,userData}),
    screen==="errors"&&e(ErrorsScreen,{userData,onStart:goErrorSession,onBack:goHome}),
    screen==="bookmarks"&&e(BookmarksScreen,{onBack:goHome,onStartSession:goBookmarkSession}),
    screen==="stats"&&e(StatsScreen,{userData,onBack:goHome}),
    screen==="browse"&&e(BrowseScreen,{onBack:goHome}),
    screen==="esej_list"&&e(EssayListScreen,{onBack:goHome,onEsej:goEsej}),
    screen==="esej"&&esejKey&&e(EssayMode,{esejKey,onBack:goEsejList,userData}),
    screen==="sazeci_list"&&e(SazetakListScreen,{onBack:goHome,onSazetak:goSazetak}),
    screen==="sazetak"&&sazetakKey&&e(SazetakMode,{sazetakKey,onBack:goSazetakList}),
    screen==="filter_session"&&e(Sim,{exam:activeExam,practice:true,examMode:false,onExit:goHome,onDone:onExamDone,userData,onPracticeErrors:goPracticeExamErrors,onStats:goStats,onFilter:goFilter}),
    screen==="errors_session"&&e(Sim,{exam:activeExam,practice:true,examMode:false,onExit:goHome,onDone:onExamDone,userData,onPracticeErrors:goPracticeExamErrors,onStats:goStats,onFilter:goFilter}),
    screen==="bookmark_session"&&e(Sim,{exam:activeExam,practice:true,examMode:false,onExit:goHome,onDone:onExamDone,userData,onPracticeErrors:goPracticeExamErrors,onStats:goStats,onFilter:goFilter}),
    screen==="practice"&&e(Sim,{exam,practice:true,examMode:false,onExit:goHome,onDone:onExamDone,userData,onPracticeErrors:goPracticeExamErrors,onStats:goStats,onFilter:goFilter}),
    screen==="exammode"&&e(Sim,{exam,practice:false,examMode:true,onExit:goHome,onDone:onExamDone,userData,onPracticeErrors:goPracticeExamErrors,onStats:goStats,onFilter:goFilter})
  );
}



