    naslov:"Odgoj i društvena sredina u životu žena — Novak i Šimunović",
    tekstovi:[
      {naslov:"Vjenceslav Novak, Posljednji Stipančići (ulomak)", tekst:ESEJ_T1_2017_ljeto},
