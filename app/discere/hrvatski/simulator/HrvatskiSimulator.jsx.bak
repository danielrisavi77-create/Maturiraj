/* ─── 2021./2022. LJETNI ROK — JEDINSTVENI ISPIT ─── */
const QS_2022_ljeto_A=[
  {id:1,type:"mc",topic:"knj_analiza",ctx:T1_2022_ljeto,ctxNaslov:"T1 — Zapuštena (Antun Branko Šimić)",q:"Koja od sljedećih tvrdnja o pjesmi nije točna?",opts:["A. Lirski subjekt u pjesmi mlada je žena.","B. Interpunkcija je u pjesmi reducirana.","C. Pjesma je pisana slobodnim stihom.","D. Pjesma je grafički organizirana."],sol:{cl:"A"},exp:"Lirski subjekt = glas koji promatra = nije sama mlada žena, već promatrač njezina života = A nije točna."},
  {id:2,type:"mc",topic:"knj_analiza",ctx:T1_2022_ljeto,ctxNaslov:"T1 — Zapuštena (Antun Branko Šimić)",q:"Što je tema pjesme?",opts:["A. umjetnost kao sredstvo ostvarivanja boljega života","B. nemogućnost ostvarivanja ispunjenoga života","C. uzaludno iščekivanje voljene osobe","D. strah od velikoga grada"],sol:{cl:"B"},exp:"Žena zapuštena, bez nade, cvijeće čezne samo = ispunjeni život nije moguć = B."},
  {id:3,type:"mc",topic:"knj_analiza",ctx:T1_2022_ljeto,ctxNaslov:"T1 — Zapuštena (Antun Branko Šimić)",q:"U čemu žena iz pjesme nalazi utjehu?",opts:["A. u čitanju","B. u kuhanju","C. u pjevanju","D. u snovima"],sol:{cl:"A"},exp:"'mlada žena ćuti pokraj peći... nad romanom Marcela Prévosta' = čitanje = A."},
  {id:4,type:"mc",topic:"knj_analiza",ctx:T2_2022_ljeto,ctxNaslov:"T2 — Osman (Ivan Gundulić) — Sunčanica i sjediljka",q:"Zašto je Ljubdrag organizirao okupljanje mladih?",opts:["A. Nadao se da će se neki mladić svidjeti njegovoj kćeri.","B. Želio je zahvaliti kćeri zato što mu je oslonac u starosti.","C. Htio je da se pastiri natječu u sviranju.","D. Zaželio se veseloga društva u kući."],sol:{cl:"A"},exp:"'jeda srce tvrdo odviše od svê kćerce one ganu: ter... kigodi joj tuj omili i obere ga vjerenika' = želi da si kćer nađe mladića = A."},
  {id:5,type:"mc",topic:"knj_analiza",ctx:T2_2022_ljeto,ctxNaslov:"T2 — Osman (Ivan Gundulić) — Sunčanica i sjediljka",q:"Što je o Ljubdragu iskazano u sljedećim stihovima?\n'Mile unuke on viditi / želi od drage kćerce ove / i u njih opet ponoviti / sebe i mrtve svê sinove.'",opts:["A. Važno mu je da se njegova loza nastavi.","B. Želi osvetiti svoje mrtve sinove.","C. Htio bi da ga unuci posjete.","D. Sluti da će uskoro umrijeti."],sol:{cl:"A"},exp:"'ponoviti sebe i mrtve sinove' = kroz unuke = nastavak loze/roda = A."},
  {id:6,type:"mc",topic:"knj_analiza",ctx:T2_2022_ljeto,ctxNaslov:"T2 — Osman (Ivan Gundulić) — Sunčanica i sjediljka",q:"U čemu se od sljedećega natječu djevojke?",opts:["A. u pletenju vjenčića","B. u pričanju priča","C. u plesanju","D. u ljepoti"],sol:{cl:"A"},exp:"'Zatjecat se još ne taže pastirice... ka začinja pjesni draže, ka li vjenčac ljepše vije' = vjenčaci = A."},
  {id:7,type:"mc",topic:"jez_stil",ctx:T3_2022_ljeto,ctxNaslov:"T3 — Tena (Josip Kozarac) — Tena i muškarci",q:"Koji izraz metaforično prikazuje Tenu?",opts:["A. zelena voćka","B. neobuzdana vatra","C. čuvstvo 'lijepoga'","D. busen cvijeta"],sol:{cl:"D"},exp:"'njezina duša već je bila podivljali busen cvijeta' = metafora za Teninu dušu/osobnost = D."},
  {id:8,type:"mc",topic:"knj_analiza",ctx:T3_2022_ljeto,ctxNaslov:"T3 — Tena (Josip Kozarac) — Tena i muškarci",q:"Koga je Tena jedino voljela?",opts:["A. Đorđa","B. Jozu","C. Leona","D. vodnika"],sol:{cl:"D"},exp:"'poslije vodnika ionako nije nikoga više ljubila' = vodnik = D."},
  {id:9,type:"mc",topic:"knj_analiza",ctx:T3_2022_ljeto,ctxNaslov:"T3 — Tena (Josip Kozarac) — Tena i muškarci",q:"Na što se odnosi sljedeća usporedba?\n'kao kada bi vidio Canovin kip u zadimljenoj seljačkoj kuhinji'",opts:["A. na Tenin smisao za kiparsku umjetnost","B. na nesklad između ljepote i okoline","C. na prijetvorno ponašanje","D. na Leonovo bogatstvo"],sol:{cl:"B"},exp:"Canova kip (fin) u zadimljenu kuhinji (neprimjeren okoliš) = Tenina ljepota u neodgovarajućoj sredini = nesklad = B."},
  {id:10,type:"mc",topic:"knj_analiza",ctx:T4_2022_ljeto,ctxNaslov:"T4 — Kiklop (Ranko Marinković) — urođenički liječnici",q:"Što je prikazano u polaznome tekstu?",opts:["A. čišćenje dimnjaka","B. istjerivanje zlih sila","C. liječenje životinja","D. ubojstvo zarobljenika"],sol:{cl:"B"},exp:"'Oni će mu još i zle duhove istjerati iz trbuha... demoni... pobjeći pred vatrom' = istjerivanje zlih sila = B."},
  {id:11,type:"mc",topic:"jez_stil",ctx:T4_2022_ljeto,ctxNaslov:"T4 — Kiklop (Ranko Marinković) — urođenički liječnici",q:"Zašto su urođenici nazvani veterinarskim stručnjacima, a agent grlom?",opts:["A. da bi se naglasilo da su urođenici obrazovani","B. da bi se istaknula dehumanizacija","C. da bi se postigla ritmičnost teksta","D. da bi se ostvario stil basne"],sol:{cl:"B"},exp:"'veterinarski stručnjaci' + 'grlo' = životinjska terminologija = agent prikazan kao životinja = dehumanizacija = B."},
  {id:12,type:"mc",topic:"knj_analiza",ctx:T4_2022_ljeto,ctxNaslov:"T4 — Kiklop (Ranko Marinković) — urođenički liječnici",q:"Koji je od sljedećih likova htio prekinuti događaj kojemu svjedoči?",opts:["A. kapetan","B. liječnik","C. upravitelj stroja","D. Veliki Vrač"],sol:{cl:"C"},exp:"'Upravitelj stroja... učini pokret kojim bi vjerojatno bio zadavio Velikoga Vrača' = htio prekinuti = C."},
  {id:13,type:"mc",topic:"knj_analiza",ctx:T5_2022_ljeto,ctxNaslov:"T5 — Zaprepaštenje (Jorge Luis Borges)",q:"Čije je zaprepaštenje prikazano?",opts:["A. ljudi na trgu","B. Moritánovo","C. Rivarolino","D. susjedovo"],sol:{cl:"A"},exp:"'Ljudi se u strahu razmaknuše... Tako poštovani građanin kao Pardo, pa da to čini pred očima i usprkos čitavom Morónu' = zaprepaštenje publike/mještana = A."},
  {id:14,type:"mc",topic:"knj_analiza",ctx:T5_2022_ljeto,ctxNaslov:"T5 — Zaprepaštenje (Jorge Luis Borges)",q:"Što susjed iz Moróna opravdava?",opts:["A. ubojičino razmetljivo odijevanje","B. glumljeno Rivarolino ludilo","C. počinjeno ubojstvo","D. zatvorsku kaznu"],sol:{cl:"B"},exp:"'Opravdavam ga; ako nekoga ubiješ i zatim moraš ispaštati u zatvoru, postupio si budalasto. Pardo je svoj plan dobro pripremio.' = opravdava oprezno planiranje/glumu = B."},
  {id:15,type:"mc",topic:"knj_analiza",ctx:T5_2022_ljeto,ctxNaslov:"T5 — Zaprepaštenje (Jorge Luis Borges)",q:"Kojim se postupkom postiže vjerodostojnost prikaza događaja?",opts:["A. detaljnim opisom lika","B. kronološkim pripovijedanjem","C. uvođenjem lika susjeda","D. završnim retoričkim pitanjem"],sol:{cl:"C"},exp:"'Jedan susjed iz Moróna izvijestio me o slučaju' = svjedok koji prenosi = vjerodostojnost = C."},
  {id:16,type:"mc",topic:"knj_analiza",ctx:T6_2022_ljeto,ctxNaslov:"T6 — Antigona (Sofoklo) — Tiresija i Kreont",q:"Koja je uloga Tiresijina obraćanja Kreontu?",opts:["A. uvjeriti Kreonta u to da je njegova odluka neispravna","B. objasniti Kreontu zašto bogovi nisu primili žrtvu","C. navesti Kreontove nepromišljene postupke","D. opravdati Kreontovo ponašanje"],sol:{cl:"A"},exp:"'Ti pusti mrtvog, ne muči poginula! Ta griješiti je prirođeno... Al' sagriješi li tko, on više čovjek lud ni nesretan bit neće ako liječi se' = uvjerava ga da je pogriješio = A."},
  {id:17,type:"mc",topic:"knj_analiza",ctx:T6_2022_ljeto,ctxNaslov:"T6 — Antigona (Sofoklo) — Tiresija i Kreont",q:"O kojemu svojem umijeću govori Tiresija u sljedećoj rečenici?\n'Pa znat ćeš kad umijeća moga čuješ znak.'",opts:["A. o proricanju budućih događaja","B. o komunikaciji s mrtvima","C. o žrtvovanju životinja","D. o uzgoju ptica"],sol:{cl:"A"},exp:"Tiresija = slijepi prorok = umijeće = proricanje = A."},
  {id:18,type:"mc",topic:"knj_analiza",ctx:T6_2022_ljeto,ctxNaslov:"T6 — Antigona (Sofoklo) — Tiresija i Kreont",q:"Koga Tiresija naziva palim jadnikom?",opts:["A. Eteokla","B. Hemona","C. Kreonta","D. Polinika"],sol:{cl:"D"},exp:"'Od Edipova sina, palog jadnika' = Edipov sin = Polinik (koji nije pokopan) = D."},
  {id:19,type:"mc",topic:"knj_analiza",ctx:T7_2022_ljeto,ctxNaslov:"T7 — Život je san (Calderón de la Barca) — Sigismundov monolog",q:"Koja je od sljedećih tvrdnja o Sigismundu točna?",opts:["A. Želi se osvetiti za nanesenu nepravdu.","B. Nastoji izazvati samilost sugovornika.","C. Očajan je zbog svojega položaja.","D. Planira pobjeći iz kule."],sol:{cl:"C"},exp:"'Jao meni, nesretniku!... a ja više duše imam, no slobode mnogo manje' = očajanje = C."},
  {id:20,type:"mc",topic:"knj_analiza",ctx:T7_2022_ljeto,ctxNaslov:"T7 — Život je san (Calderón de la Barca) — Sigismundov monolog",q:"Na kojoj je antitezi utemeljen Sigismundov monolog?",opts:["A. dobro – zlo","B. privid – stvarnost","C. rođenje – smrt","D. ropstvo – sloboda"],sol:{cl:"D"},exp:"'a ja više duše imam, no slobode mnogo manje' = životinje imaju slobodu, Sigismund nema = ropstvo↔sloboda = D."},
  {id:21,type:"mc",topic:"knj_analiza",ctx:T7_2022_ljeto,ctxNaslov:"T7 — Život je san (Calderón de la Barca) — Sigismundov monolog",q:"Tko je kriv za Sigismundovo trenutačno stanje?",opts:["A. Astolfo","B. Bazilije","C. Klotaldo","D. Rosaura"],sol:{cl:"B"},exp:"Bazilije = otac koji je zatvorio Sigismunda u kulu zbog proročanstva = B."},
  {id:22,type:"mc",topic:"knj_analiza",ctx:T8_2022_ljeto,ctxNaslov:"T8 — Nadrealisti i kravate (Viktor Žmegač)",q:"Koja je od sljedećih tvrdnja o avangardistima s fotografije točna?",opts:["A. Avangardnom su odjećom ukazivali na modernost svojih djela.","B. Njihova je provokativnost proizlazila iz djela koja su stvarali.","C. Svojim su izgledom željeli zainteresirati gledatelje.","D. Njihova je umjetnost bila uniformirana."],sol:{cl:"B"},exp:"'Antigrađanski nasrtaji bili su u slikama i riječima... autora pomno građanski obučenih' = provokativnost u djelima, ne u odjeći = B."},
  {id:23,type:"mc",topic:"knj_analiza",ctx:T8_2022_ljeto,ctxNaslov:"T8 — Nadrealisti i kravate (Viktor Žmegač)",q:"Zašto avangardiste s fotografije ne treba predstaviti?",opts:["A. jer njihova umjetnost pripada prošlosti","B. jer ih fotografija dovoljno prikazuje","C. jer su nevažni za temu eseja","D. jer su vrlo poznati"],sol:{cl:"D"},exp:"'ličnosti koje ne treba predstaviti: Tristan Tzara, André Breton, Salvador Dalí...' = poznati = D."},
  {id:24,type:"mc",topic:"knj_analiza",ctx:T8_2022_ljeto,ctxNaslov:"T8 — Nadrealisti i kravate (Viktor Žmegač)",q:"Što od sljedećega autor iskazuje o umjetnosti svojega vremena?",opts:["A. Nekonvencionalna je.","B. Puna je proturječja.","C. Provokativna je.","D. Neoriginalna je."],sol:{cl:"D"},exp:"'ali ne uočava da je umjetnost postala repetitivna' = ponavljanje = neoriginalna = D."},
  {id:25,type:"mc",topic:"knj_analiza",ctx:T9_2022_ljeto,ctxNaslov:"T9 — Utjecaj monitora (Darko Grundler)",q:"Koja je namjena teksta?",opts:["A. upozoriti na opasnost pri upotrebi monitora računala","B. potaknuti istraživanje o utjecaju monitora na ljude","C. promovirati nove tehnologije u izradi monitora","D. objasniti utjecaj monitora na okolinu"],sol:{cl:"D"},exp:"Tekst objašnjava EMI, EMC i emisije = utjecaj monitora na okolinu i ljude = D."},
  {id:26,type:"mc",topic:"knj_analiza",ctx:T9_2022_ljeto,ctxNaslov:"T9 — Utjecaj monitora (Darko Grundler)",q:"Zbog čega su monitori potencijalno štetni za ljude?",opts:["A. zbog elektromagnetske interferencije","B. zbog elektromagnetske sukladnosti","C. zbog toga što sadrže olovo","D. zbog ELF i VLF emisije"],sol:{cl:"D"},exp:"'monitori proizvode dvije vrste emisija koje mogu utjecati na zdravlje. ELF... VLF' = D."},
  {id:27,type:"mc",topic:"knj_analiza",ctx:T9_2022_ljeto,ctxNaslov:"T9 — Utjecaj monitora (Darko Grundler)",q:"Što se povećava s višim pogonskim naponima kod višebojnih monitora?",opts:["A. elektromagnetska sukladnost uređaja","B. količina olova u katodnoj cijevi","C. filtriranje signala monitora","D. zračenje monitora"],sol:{cl:"D"},exp:"'Viši pogonski naponi, kod višebojnih monitora, uzrokuju u načelu i veće razine emisije' = više emisije = više zračenja = D."},
  {id:28,type:"mc",topic:"knj_analiza",ctx:T10_2022_ljeto,ctxNaslov:"T10 — Savršena tjestenina (recept/savjeti)",q:"Koja je namjena teksta?",opts:["A. analizirati zašto se tjestenina kuhanjem sljepljuje","B. potaknuti ljude na kuhanje jela s tjesteninom","C. objasniti kako se pravilno kuha tjestenina","D. opisati nastanak raskuhane tjestenine"],sol:{cl:"C"},exp:"Tekst daje savjete za pravilno kuhanje tjestenine = C."},
  {id:29,type:"mc",topic:"knj_analiza",ctx:T10_2022_ljeto,ctxNaslov:"T10 — Savršena tjestenina (recept/savjeti)",q:"Na koji se od sljedećih načina može izbjeći sljepljivanje tjestenine?",opts:["A. odabirom tjestenine s manjim udjelom proteina","B. miješanjem tjestenine prilikom kuhanja","C. soljenjem vode tek nakon što zavre","D. dodavanjem ulja tijekom kuhanja"],sol:{cl:"B"},exp:"'promiješate 3 – 4 puta u 10 minuta kako ne bi došlo do neželjenoga sljepljivanja' = miješanje = B."},
  {id:30,type:"mc",topic:"knj_analiza",ctx:T10_2022_ljeto,ctxNaslov:"T10 — Savršena tjestenina (recept/savjeti)",q:"Što od sljedećega negativno utječe na kvalitetu skuhane tjestenine?",opts:["A. ispiranje tjestenine nakon kuhanja","B. često kušanje tijekom kuhanja","C. al dente čvrstoća tjestenine","D. visoka elastičnost tjestenine"],sol:{cl:"A"},exp:"'Tjesteninu nakon kuhanja nemojte ispirati jer se tako gubi škrob i sva slasnost' = ispiranje = negativno = A."},
  /* Bez teksta 31–55 */
  {id:31,type:"mc",topic:"jez_stil",q:"Koja je stilska figura upotrijebljena u sljedećemu primjeru?\n'– Majko, zašto je hladno u našoj sobi? – Jer nema ugljena... – A zašto nema ugljena? – Jer tata nema posla. – A zašto tata nema posla? – Jer ima previše ugljena.'",opts:["A. anadiploza","B. paradoks","C. polisindeton","D. retoričko pitanje"],sol:{cl:"B"},exp:"'Ima previše ugljena' a nema posla koji bi ga nabavio = logički apsurd/kontradikcija = paradoks = B."},
  {id:32,type:"mc",topic:"jez_stil",q:"Koji je od sljedećih naslova utemeljen na antitezi?",opts:["A. Kraljević i prosjak","B. Prokleta avlija","C. Zločin i kazna","D. Crni mačak"],sol:{cl:"A"},exp:"Kraljević i prosjak = suprotni položaji = antiteza = A."},
  {id:33,type:"mc",topic:"knj_analiza",q:"Koji je stih karakterističan za antičke epove?",opts:["A. epski deseterac","B. heksametar","C. jedanaesterac","D. simetrični osmerac"],sol:{cl:"B"},exp:"Heksametar = stih Ilijade i Odiseje = antički ep = B."},
  {id:34,type:"mc",topic:"knj_analiza",q:"Koja se od sljedećih tvrdnja odnosi na elegiju?",opts:["A. Namijenjena je buđenju nacionalne svijesti.","B. Pisana je u obliku dijaloga popraćenih glazbom.","C. Uzvišenim tonom slave se životne radosti i ljepota prirode.","D. Iskazuje se bolno iskustvo, razdvojenost od doma ili drage osobe."],sol:{cl:"D"},exp:"Elegija = tužna pjesma = razdvojenost, bol, gubitak = D."},
  {id:35,type:"mc",topic:"knj_analiza",q:"Koji su od sljedećih stihova dvostrukorimovani dvanaesterci?",opts:["A. Da bim znala, drago, da oćeš bit mornar, / Ja ću plavcu moju s zlatom okovati,","B. Lepo pevaj, ptiček, drobni moj slaviček, / vu zeleni gori, na kiti borovi.","C. Tuge mje, tuge, vsaki dan ste druge, / Ne jur vsaki danak neg i vsaku uru,","D. Slavi svak iz glasa ovu vil gizdavu, / Ka nosi od vlasa venčac lip na glavu,"],sol:{cl:"D"},exp:"'Slavi svak iz glasa ovu vil gizdavu / Ka nosi od vlasa venčac lip na glavu' = 12 slogova + rima u sredini i na kraju = D."},
  {id:36,type:"mc",topic:"knj_analiza",q:"Na kojega se pjesnika odnosi sljedeća tvrdnja?\n'Naslovom svoje zbirke pjesama, kojom je najavio modernizam, ukazuje na spoj materijalnoga i duhovnoga, ljepote i ružnoće, dobra i zla.'",opts:["A. na Antuna Branka Šimića","B. na Charlesa Baudelairea","C. na Francesca Petrarcu","D. na Tina Ujevića"],sol:{cl:"B"},exp:"Cvjetovi zla (Baudelaire) = ljepota+zlo = modernizam = B."},
  {id:37,type:"mc",topic:"knj_analiza",q:"Na koju se Ujevićevu pjesničku zbirku odnosi sljedeća tvrdnja?\n'Ta je zbirka od 48 pjesama pisana u duhu petrarkističke tradicije pa se lirski subjekt često obraća imaginarnoj, nedohvatljivoj gospi koja ga istodobno i privlači i uništava.'",opts:["A. na Kolajnu","B. na Lelek sebra","C. na Ojađeno zvono","D. na Žedan kamen na studencu"],sol:{cl:"A"},exp:"Kolajna (Ujević, 1926.) = petrarkistička tradicija = imaginarni lik gospe = A."},
  {id:38,type:"mc",topic:"knj_analiza",q:"U kojemu se pjevanju epa Smrt Smail-age Čengića nalaze sljedeći stihovi?\n'Djeco moja, hrabri zatočnici... / Djedi vaši rodiše se tudijer... / Za vas ljepše u svijetu neima.'",opts:["A. u Agovanju","B. u Noćniku","C. u Četi","D. u Haraču"],sol:{cl:"C"},exp:"Govor vođe vojsci pred bitku = Četa (pjevanje o pripremi za napad) = C."},
  {id:39,type:"mc",topic:"knj_analiza",q:"Koja se od sljedećih tvrdnja odnosi na Porfirija Petroviča iz romana Zločin i kazna?",opts:["A. Stariji je gospodin koji traži siromašnu djevojku za ženu koja bi mu bila pokorna i zahvalna.","B. Svojom lukavošću i psihološkim igrama želi navesti Raskoljnikova na priznanje zločina.","C. Suprug je Marfe Petrovne, a udvara se Raskoljnikovljevoj sestri Dunji.","D. Propali je činovnik koji je zbog alkohola uništio svoju obitelj."],sol:{cl:"B"},exp:"Porfirij Petrovič = istražni sudac = psihološke igre s Raskoljnikovim = B."},
  {id:40,type:"mc",topic:"knj_analiza",q:"Zašto se roman Patnje mladog Werthera određuje kao epistolarni roman?",opts:["A. Pisan je u 1. licu.","B. Sadrži dnevničke zapise.","C. Pisan je u obliku pisama.","D. Nastao je u razdoblju predromantizma."],sol:{cl:"C"},exp:"Epistolarni = od lat. epistola (pismo) = roman u obliku pisama = C."},
  {id:41,type:"mc",topic:"knj_analiza",q:"Koji je dramski junak izgovorio sljedeću rečenicu?\n'Slabosti, ime ti je žena!'",opts:["A. Kreont govoreći o Antigoni","B. Miljenko govoreći o Dubravki","C. Leone govoreći o barunici Glembay","D. Hamlet govoreći o Gertrudi"],sol:{cl:"D"},exp:"'Frailty, thy name is woman!' = Hamlet o majci Gertrudi (nakon Klaudijeva vjenčanja) = D."},
  {id:42,type:"mc",topic:"knj_analiza",q:"Iz kojega su književnog djela sljedeće rečenice?\n'CENTROREKAM objavljuje urbi et orbi s visokoga krova... nemoćno zapomaganje slijepca-prodavača: Končane svezice...'",opts:["A. iz Kiklopa","B. iz Preobražaja","C. iz Zločina i kazne","D. iz Patnja mladog Werthera"],sol:{cl:"A"},exp:"CENTROREKAM + Zagreb + grad = Kiklop (Marinković) = A."},
  {id:43,type:"mc",topic:"knj_analiza",q:"Na kojega se književnika odnosi sljedeća tvrdnja?\n'U prvoj fazi stvaralaštva zaokupljen je pitanjem o smislu i svrsi čovjekova postojanja, a život doživljava kao niz apsurda.'",opts:["A. na Alberta Camusja","B. na Fjodora Mihajloviča Dostojevskog","C. na Franza Kafku","D. na Pedra Calderóna de la Barcu"],sol:{cl:"A"},exp:"Albert Camus = egzistencijalizam = apsurd = Stranac, Kuga, Mit o Sizifu = A."},
  {id:44,type:"mc",topic:"knj_analiza",q:"Koja se od sljedećih tvrdnja odnosi na klasičnu grčku tragediju?",opts:["A. Namjera je prikazati neku aktualnu temu ili naglasiti neku lošu karakternu osobinu.","B. Glavni lik stradava jer je djelovao u skladu sa svojim moralnim načelima.","C. Pisana je u prozi, jednostavnim stilom i svakodnevnim govorom.","D. Stalni su likovi škrti starac, zaljubljeni mladić i lukavi sluga."],sol:{cl:"B"},exp:"Klasična tragedija = tragična krivnja = junaci stradavaju zbog moralnih načela ili hamartije = B."},
  {id:45,type:"mc",topic:"knj_analiza",q:"U čemu je Antigonina tragična krivnja?",opts:["A. Htjela je odgovornost za bratov pokop podijeliti sa svojom sestrom.","B. Uime moralnoga zakona prekršila je zakon vladara.","C. Skrivila je smrt svojega zaručnika.","D. Ubila se."],sol:{cl:"B"},exp:"Antigona = pokopala Polinika = moralni zakon bogova > Kreontova zabrana = tragična krivnja = B."},
  {id:46,type:"mc",topic:"knj_analiza",q:"Kako se naziva dramski postupak kojim se spuštanjem božanstva na scenu razrješava zaplet?",opts:["A. ab ovo","B. deus ex machina","C. in medias res","D. quid pro quo"],sol:{cl:"B"},exp:"Deus ex machina = bog iz stroja = spuštanje božanstva = razrješenje zapleta = B."},
  {id:47,type:"mc",topic:"knj_analiza",q:"Koja od sljedećih književnih vrsta pripada epskomu rodu?",opts:["A. epigram","B. mit","C. oda","D. tragedija"],sol:{cl:"B"},exp:"Mit = epski/narativni rod. Epigram, oda = lirski. Tragedija = dramski = B."},
  {id:48,type:"mc",topic:"knj_analiza",q:"Tko u Shakespeareovoj tragediji Hamlet izgovara sljedeće rečenice?\n'Ide već / U sobu svoje majke, gospodaru, / A ja ću stati iza zastora, / Da čujem što će biti.'",opts:["A. Hamlet","B. Klaudije","C. Laert","D. Polonije"],sol:{cl:"D"},exp:"Polonije = uhoda = stoji iza zastora = čuje majku i Hamleta = uboji ga Hamlet = D."},
  {id:49,type:"mc",topic:"knj_analiza",q:"Koja se od sljedećih tvrdnja odnosi na Dubravku Ivana Gundulića?",opts:["A. Djelo je monolog u kojemu se glavni lik prisjeća svojega grijeha, zatim spoznaje ispraznost ljudskih nastojanja, a na kraju se vraća Bogu.","B. U djelu je prikazan pastoralni svijet na temelju kojega se iščitava društveno-politička stvarnost.","C. Djelo sadrži prepjeve biblijskih pokorničkih psalama kojima autor prekida pisanje mladenačkih drama.","D. Djelo se temelji na aktualnim događajima iz autorova vremena i govori o borbi za prijestolje."],sol:{cl:"B"},exp:"Dubravka (Gundulić) = pastoralna drama = alegorija slobode Dubrovnika = B."},
  {id:50,type:"mc",topic:"knj_analiza",q:"U kojemu je književnom razdoblju nastao pjesnički pravac marinizam?",opts:["A. u renesansi","B. u baroku","C. u klasicizmu","D. u romantizmu"],sol:{cl:"B"},exp:"Marinizam = talijanski barok = Giambattista Marino = B."},
  {id:51,type:"mc",topic:"knj_analiza",q:"Koji je od sljedećih književnih pravaca nastao pod utjecajem psihoanalitičke teorije Sigmunda Freuda?",opts:["A. dadaizam","B. ekspresionizam","C. futurizam","D. nadrealizam"],sol:{cl:"D"},exp:"Nadrealizam = podsvijest + automatsko pisanje = Freud = D."},
  {id:52,type:"mc",topic:"knj_analiza",q:"Koji od sljedećih pjesnika pripada razdoblju realizma?",opts:["A. Silvije Strahimir Kranjčević","B. Antun Gustav Matoš","C. Antun Branko Šimić","D. Augustin Tin Ujević"],sol:{cl:"A"},exp:"Kranjčević (1865.–1908.) = hrv. realizam/parnasizam = A."},
  {id:53,type:"mc",topic:"knj_analiza",q:"Koja je od sljedećih tvrdnja o trubadurskoj lirici točna?",opts:["A. Nastala je u renesansnome Dubrovniku.","B. Nastala je u srednjovjekovnoj Europi.","C. Nastala je u predrenesansnoj Italiji.","D. Nastala je u antičkome Rimu."],sol:{cl:"B"},exp:"Trubaduri = provansalski pjesnici 11.–13. st. = srednji vijek = Europа = B."},
  {id:54,type:"mc",topic:"knj_analiza",q:"Što je od sljedećega obilježje realističke poetike?",opts:["A. subjektivni pripovjedač","B. humanizirani pejzaž","C. načelo tipičnosti","D. svjetska bol"],sol:{cl:"C"},exp:"Realizam = tipični likovi u tipičnim okolnostima = načelo tipičnosti = C."},
  {id:55,type:"mc",topic:"knj_analiza",q:"Koje je od sljedećih obilježja karakteristično za književnost postmodernizma?",opts:["A. deskriptivnost","B. intertekstualnost","C. moralističnost","D. tendencioznost"],sol:{cl:"B"},exp:"Postmodernizam = intertekstualnost, citiranje, ironija = B."},
  /* Jezični 56–80 */
  {id:56,type:"mc",topic:"jez_pravopis",q:"Koji je od sljedećih primjera pravopisno točan?",opts:["A. piješčani sat","B. razgovijetan izgovor","C. skupocijena ogrlica","D. zvijezdana staza"],sol:{cl:"B"},exp:"'Razgovijetan' = pravilno. 'Piješčani'→'pješčani', 'skupocijena'→'skupocjena', 'zvijezdana'→'zvjezdana'."},
  {id:57,type:"mc",topic:"jez_pravopis",q:"Koji je od sljedećih izraza pravopisno točan?",opts:["A. svečenički poziv","B. svečenićki poziv","C. svećenički poziv","D. svećenićki poziv"],sol:{cl:"C"},exp:"'Svećenički' = svećenik + -ki = pravilno = C."},
  {id:58,type:"mc",topic:"jez_pravopis",q:"Koja je od sljedećih rečenica napisana u skladu s pravilima o pisanju velikoga i maloga početnog slova?",opts:["A. Apollo 11 bila je svemirska misija koja je 20. srpnja 1969. dovela prve ljude na zemljin satelit Mjesec.","B. Taj se let smatra velikim postignućem u povijesti istraživanja svemira i pobjeda je SAD-a u hladnoratovskoj utrci sa Sovjetskim savezom.","C. Armstrong i Aldrin sletjeli su na prostor nazvan More tišine i postali prvi ljudi na površini Mjeseca.","D. Tri astronauta vratila su se na Zemlju s 21,55 kg mjesečeva kamenja, sletjevši 24. srpnja u Tihi Ocean."],sol:{cl:"C"},exp:"'More tišine' = naziv lokaliteta na Mjesecu = vlastita imenica = C."},
  {id:59,type:"mc",topic:"jez_pravopis",q:"U kojoj je od sljedećih rečenica podcrtani primjer pravopisno točan?",opts:["A. Na satu kemije određivali smo ph – vrijednosti tekućina.","B. Napeto smo iščekivali utakmicu Hajduk – Dinamo.","C. Suncokreti su Van Goghovo remek – djelo.","D. Kupili smo ogrlicu od 18 – karatnoga zlata."],sol:{cl:"B"},exp:"'Hajduk – Dinamo' = crtica (spojnica) između naziva protivnika = pravilno = B."},
  {id:60,type:"mc",topic:"jez_gram",q:"U kojoj je od sljedećih riječi provedena jotacija?",opts:["A. prepečem","B. preskačem","C. presvučem","D. pretučem"],sol:{cl:"C"},exec:"todo",exp:"'Presvučem' = presvuć+em: č+j → č = jotacija... zapravo 'presvučem' = pre+svuć+em: k+j → č = jotacija = C."},
  {id:61,type:"mc",topic:"jez_gram",q:"U kojoj je od sljedećih riječi provedeno i jednačenje po zvučnosti i jednačenje po mjestu tvorbe?",opts:["A. besraman","B. bešuman","C. bezbožan","D. bežičan"],sol:{cl:"B"},exp:"'Bešuman' = bez+šuman: z ispred š = s (zvučnost) + z→š (mjesto tvorbe) = oba jednačenja = B."},
  {id:62,type:"mc",topic:"jez_gram",q:"U kojemu je primjeru riječ 'pripovijedati' točno naglašena?",opts:["A. pripovijêdati","B. pripovijèdati","C. pripovijédati","D. pripovijȅdati"],sol:{cl:"C"},exp:"'Pripovijédati' = dugouzlazni = pravilno = C."},
  {id:63,type:"mc",topic:"jez_gram",q:"Koja je riječ u sljedećoj rečenici zanaglasnica?\n'Razmišljam o tome primjećuješ li i ti to.'",opts:["A. o","B. li","C. i","D. to"],sol:{cl:"B"},exp:"'Li' = upitna čestica = nenaglasnica/zanaglasnica = B."},
  {id:64,type:"mc",topic:"jez_gram",q:"Koji je morfem korijenski u riječi 'poučavatelj'?",opts:["A. po-","B. -uč-","C. -telj-","D. -Ø"],sol:{cl:"B"},exp:"'Poučavatelj' = po- (prefiks) + -uč- (korijen) + -av- + -a- + -telj- + (-Ø nastavak) = B."},
  {id:65,type:"mc",topic:"jez_gram",q:"Što je oblikotvorna/gramatička osnova u riječi 'predradnik'?",opts:["A. rad","B. predrad","C. predradni","D. predradnik"],sol:{cl:"D"},exp:"'Predradnik' = predradnik+Ø = oblikotvorna osnova = predradnik (bez nultog nastavka) = D."},
  {id:66,type:"mc",topic:"jez_gram",q:"U kojoj je od sljedećih rečenica podcrtana imenica srednjega roda?",opts:["A. Na leđima je imala madež u obliku zvijezde.","B. I ove ćemo godine staviti jaslice pod bor.","C. Svaki rat za sobom ostavlja siročad.","D. Čula je to na svoje uši."],sol:{cl:"C"},exp:"'Siročad' = zbirna imenica sr.roda = C."},
  {id:67,type:"mc",topic:"jez_gram",q:"Koja je od podcrtanih riječi u sljedećoj rečenici u dativu?\n'U tome turističkom mjestu divimo se mnogobrojnim šetalištima s kojih pogled dopire do prekrasnih austrougarskih vila.'",opts:["A. turističkom","B. mnogobrojnim","C. kojih","D. austrougarskih"],sol:{cl:"B"},exp:"'Divimo se... šetalištima' = šetalištima = dativ = 'mnogobrojnim' = atribut u dativu = B."},
  {id:68,type:"mc",topic:"jez_gram",q:"U kojoj je od sljedećih rečenica upotrijebljen točan oblik pridjeva?",opts:["A. Gregor je želio da otac bude dobri prema njemu.","B. Gledao sam emisiju o ljudima najhrabrija srca.","C. Kopernik je pojasnio heliocentrični sustav.","D. Nigdje nije bilo onoga poznata glumca."],sol:{cl:"C"},exp:"'Heliocentrični sustav' = pravilno. 'Dobri'→'dobar', 'najhrabrija srca'→'najhrabrijih', 'poznata glumca'→'poznatog glumca'."},
  {id:69,type:"mc",topic:"jez_gram",q:"Koji je glagol u sljedećoj rečenici u prezentu?\n'Umjesto da smjesta pobjegne, okrenu se, potiho zaplaka i još dugo u noć jecaše.'",opts:["A. pobjegne","B. okrenu se","C. zaplaka","D. jecaše"],sol:{cl:"A"},exp:"'Pobjegne' = prezent u zavisnoj rečenici (da+prezent) = A."},
  {id:70,type:"mc",topic:"jez_gram",q:"Koji je glagolski oblik podcrtan u sljedećoj rečenici?\n'Kad budemo dolazili, osvijetli nam put.'",opts:["A. futur prvi","B. futur drugi","C. kondicional prvi","D. kondicional drugi"],sol:{cl:"B"},exp:"'Budemo dolazili' = budem + infinitiv = futur drugi = B."},
  {id:71,type:"mc",topic:"jez_gram",q:"Koja je riječ u sljedećoj rečenici prilog?\n'Hodao je uporno preko oštroga stijenja unatoč svim nevoljama koje su ga toga jutra pratile.'",opts:["A. uporno","B. preko","C. unatoč","D. jutra"],sol:{cl:"A"},exp:"'Uporno' = prilog načina uz glagol hodao = A."},
  {id:72,type:"mc",topic:"jez_gram",q:"Kojim je tvorbenim načinom nastala riječ 'blatobran'?",opts:["A. prefiksalno-sufiksalnom tvorbom","B. složeno-sufiksalnom tvorbom","C. sufiksalnom tvorbom","D. čistim slaganjem"],sol:{cl:"D"},exp:"'Blatobran' = blato + bran(iti) = čisto slaganje (dvije osnove bez sufiksa) = D."},
  {id:73,type:"mc",topic:"jez_gram",q:"Koja je od sljedećih riječi tvorena sufiksom -nik?",opts:["A. bolesnik","B. nasilnik","C. patnik","D. sretnik"],sol:{cl:"A"},exp:"'Bolesnik' = bolest + -nik (pridjev ne, imenica da) = sufiksom -nik = A."},
  {id:74,type:"mc",topic:"jez_gram",q:"Koja je od sljedećih riječi nastala prefiksalnom tvorbom?",opts:["A. zaboraviti","B. zanovijetati","C. zapisati","D. zatvoriti"],sol:{cl:"C"},exp:"'Zapisati' = za- (prefiks) + pisati = prefiksalna tvorba = C."},
  {id:75,type:"mc",topic:"jez_leks",q:"U kojoj je od sljedećih rečenica podcrtani primjer eponim?",opts:["A. Tajnu originalne pripreme kremšnita znaju samo samoborske slastičarnice.","B. Čvarci, kulen i kulenova seka dobro su poznati i izvan granica Lijepe Naše.","C. Đurđevački pijesci jedinstven su prirodni fenomen u Hrvatskoj.","D. Cipele manolice nazvane su prema poznatome dizajneru."],sol:{cl:"D"},exp:"'Manolice' = cipele nazvane prema Manolu Blaniku = eponim = D."},
  {id:76,type:"mc",topic:"jez_leks",q:"Koji od sljedećih frazema znači 'pogoršavati situaciju'?",opts:["A. dolijevati ulje na vatru","B. otvoriti na koga vatru","C. pregrmjeti prvu vatru","D. igrati se vatrom"],sol:{cl:"A"},exp:"'Dolijevati ulje na vatru' = pogoršavati sukob = A."},
  {id:77,type:"mc",topic:"jez_leks",q:"Koja je od sljedećih riječi bliskoznačna podcrtanoj?\n'U svojim je lucidnim trenutcima došao do bitnih spoznaja.'",opts:["A. ludim","B. pronicavim","C. rijetkim","D. važnim"],sol:{cl:"B"},exp:"'Lucidan' = bistar/pronicav = B."},
  {id:78,type:"mc",topic:"jez_leks",q:"U kojemu je od sljedećih primjera ktetik?",opts:["A. eskimski iglu","B. lepoglavska čipka","C. matoševski sonet","D. zemaljska kugla"],sol:{cl:"B"},exp:"'Lepoglavska čipka' = pridjev od imenice mjesta Lepoglava = ktetik = B."},
  {id:79,type:"mc",topic:"jez_gram",q:"Kojemu funkcionalnom stilu hrvatskoga jezika pripadaju ove rečenice?\n'Flavonoidi su heterogena skupina spojeva čija osnovna struktura je kostur difenilpropana...'",opts:["A. administrativnomu","B. književnoumjetničkomu","C. publicističkomu","D. znanstvenomu"],sol:{cl:"D"},exp:"Stručna/kemijska terminologija, objektivan opis = znanstveni stil = D."},
  {id:80,type:"mc",topic:"jez_gram",q:"Koja se od sljedećih tvrdnja odnosi na prvi hrvatski tiskani rječnik?",opts:["A. Skupljeno leksičko blago u prvome je redu kajkavsko, ali ima štokavizama i čakavizama, što je u skladu s načelima ozaljskoga jezičnog kruga kojemu autor pripada.","B. Rječnik je tiskan u Veneciji 1595., a hrvatski je jezik u njemu nazvan jednim od pet najuglednijih europskih jezika.","C. Premda je rječnik ograničen uglavnom na hrvatsko kajkavsko jezično područje, važan je po tome što je prvi kajkavsko-latinski rječnik.","D. U tome je trojezičnom rječniku prvi put hrvatski polazni jezik."],sol:{cl:"B"},exp:"Faust Vrančić, Dictionarium quinque (1595., Venecija) = 5 najuglednijih europskih jezika = B."},
];

/* ─── 2021./2022. JESENSKI ROK — VIŠA RAZINA (A) — D-S056 ─── */
const T1_2022_jesen_A=`Charles Baudelaire, Glas

Kolijevka mi bila tik do biblioteke,
Babilona mračnog, gdje roman, znanost, fablió,
Latinski pepeo i grčka prašina, sve se
Miješalo. Bijah tad velik ko in-folio.
Dva mi zborahu glasa. Prvi, čvrst i zavodljiv,
Govoraše: „Zemlja je slatkiš pun miline;
Mogu (a tad bi ti slast beskrajna bila!)
Rodit u tebi hlepnju iste veličine."
A drugi: „Oh, dođi! putovat u snima,
S one strane mogućeg, onkraj sveg znanog!"
I taj glas pjevaše ko vjetar duž žalâ,
Sablastan cvilež, a ne zna se odakle,
Što miluje uho a ipak ga straši.
Rekoh ti: „Da! Mili glasu!" i otad, jao!
Počinje to što bih svojom ranom nazv'o
I zlom kobi. Iza kulisa neizmjernog
Postojanja, u jami bezdanoj crnoj,
Razabirem jasno svjetove osebujne
I, žrtvom ushitne te oštrovidnosti,
Vučem za sobom zmije što mi cipele grizu.
I od vremena tog, nalik na proroke,
Ljubim tako nježno pustinju i more;
Pak se u koroti smijem, a na slavlju plačem
I sladak okus ćutim u vinu najgorčem;
Činjenice često pak lažima držim,
Te, u nebo zureć, upadam u rupe.
Ali Glas me tješi: „Snove svoje čuvaj:
Sni ludih su ljepši nego sni mudraca!"

Charles Baudelaire`;

const T2_2022_jesen_A=`Ivan Gundulić, Osman (ulomak — o narodu i vladaru)

Puk je slijepac koji oči
ne ima od svjeta i od razbora:
za istinu laž svjedoči
sred taštine i žamora;
sveđ nekrepak, nigda stavan,
ljubi, mrzi, hoće i neće,
trom, lijen, strašiv i pripravan
na pobune i na smeće;
sad mir žudi, sad boj ište,
vazda hlepi na prominu:
sad uzvisi koga tište,
koga uzvisi sad ukinu.
Ali kako tiho more
vik po sebi ne uzrasti
dokli silni vihor s gore
ne smuti ga svojom vlasti,
puk u bitju smernu tako
uzdignut se vik ne smije
što na pomoć dmjenje jako
moguće mu glave nije.
S izgleda se tim ovoga
svak tko vlada sad nauči
da nije se uzdat u nikoga
stvar velika kad se odluči.
Mao izide glas najprvi,
ali u svačijeh ustih rasti
ter, čim odsvud većma vrvi,
sve obujmi svojom vlasti.
A istina je riječ na svijeti
da se zemlja kletvom klela
da će otajstva sva pronijeti
ka je čula i vidjela.

Ivan Gundulić, Osman`;

const T3_2022_jesen_A=`Miguel de Cervantes Saavedra, Bistri vitez Don Quijote od Manche (ulomak)

Don Quijote ne počasi časka, nego se odmah s maturantom i župnikom skloni nasamo i ispripovjedi im ukratko kako je pobijeđen, te se obvezao da godinu dana neće odlaziti iz svojega sela. Kao skitnik vitez, koji mora obdržavati red i zakon skitničkog viteštva; voljan je držati se točno svoje obveze i ni za trenutak je ne kršiti, pa je zamislio da za tu godinu dana bude pastir i da se bavi dalekim poljima, gdje se može po miloj volji zanositi u svoje ljubavne misli, i odavati se čestitome pastirskom živovanju. Moli ih dakle, ako nisu jako zabavljeni i ne priječe ih važniji poslovi, neka mu se pridruže. On će nakupovati dosta ovaca i krda, da se mogu prozvati pastirima, a neka znaju da je najglavniji posao već svršen, jer im je ponadijevao imena da im ne bi ni mogla biti zgodnija. Zamoli ga župnik da im rekne ta imena. Don Quijote mu odgovori da će se on zvati pastir Quijotiz, maturant pastir Carrascon, župnik pastir Curiambro, a Sancho Pansa pastir Pancino. Zaprepaste se svi kad su čuli novu ludost don Quijoteovu, ali se ponadaju da će se za godinu dana izliječiti, pa da ne odlazi i opet iz sela za svojim viteškim poslovima, pristanu uz njegov naum, odobre mu budalaštinu, da je pametna, i obećaju mu da će mu se pridružiti.
– I onako zna već sav svijet – reći će Sansón Carrasco – da sam ja slavan pjesnik. Ja ću dakle neprestano sastavljati pastirske i ljubavne pjesme, ili što mi se desi, da se zabavimo po onoj zabiti po kojoj ćemo obilaziti. Ali najvažnije je, gospodo moja, da svatko odabere ime pastirici koju će slaviti pjesmama, te da ne bi bilo drveta, kako god tvrdo bilo, u koje ne bismo upisivali i urezivali njeno ime, kao što je navada i običaj zaljubljenim pastirima.

Miguel de Cervantes Saavedra, Don Quijote`;

const T4_2022_jesen_A=`Gustave Flaubert, Gospođa Bovary (ulomak — Emmin nostalgični trenutak)

Emma zadrži nekoliko časaka među prstima taj prosti papir. U pismu je sve vrvjelo od pravopisnih pogrešaka, ali ona je pratila očeve nježne misli, koje su se kroz čitavo pismo neprestano ponavljale kao kokodakanje kokoši koja je napola skrivena u trnovoj živici. Pismo je bilo posušeno pepelom s ognjišta, jer je malo sive prašine kliznulo s lista na njezinu haljinu, i Emmi se pričini da gotovo vidi svog oca kako se sagiba nad ognjište da uhvati mašice. Oh, kako je tome davno otkako više nije sjedila kraj njega na klupici pred kaminom kada je palila vrh kakva štapića na velikom plamenu od morske trske koja je veselo pucketala!... Ona se sjeti ljetnih poslijepodneva, punih sunca. Ždrebad je rzala kad si pored njih prolazio, i trčala, i trčala... Pod njezinim je prozorom stajala košnica, i pčele su pokatkad, kružeći u svjetlu, udarale o okna i odskakivale od njih kao zlatne gumene kuglice. Kako su sretni bili ti dani! Kakva sloboda! Kakve nade! Koliko snova! A sada ništa od svega toga nije preostalo. Sve je to ona rasipala u svima doživljajima svoje duše, u svim prilikama redom, u djevojaštvu, u braku i u ljubavi, i gubila tako neprestano kroz život kao putnik koji u svakom svratištu na putu ostavlja ponešto od svoga bogatstva.

Gustave Flaubert, Gospođa Bovary`;

const T5_2022_jesen_A=`Ranko Marinković, Kiklop (ulomak — Melkior i dijete rata)

Melkior se nasloni na prozor. Vojarna još spava. (...) Tu u susjednoj kući stanuje jedna mlada žena u posljednjem mjesecu trudnoće. Što će roditi? Kćerku. Onda će je učiti, kad poodraste, da žena drži tri ugla kuće a muž samo četvrti. (Ako padne bomba tko će držati uglove?) Ako rodi sina otac će se brinuti za njegovu BUDUĆNOST koja bi mogla trajati i više od tri mjeseca. Kupit će mu malu pušku s oprugom i olovne vojnike, neka se mali igra. Mali će po cio dan držati stražu pred njihovom kućom kao onaj vojnik preko ulice pred vojarnom i pucat će na nenaoružanu djecu – neprijatelje iz susjednih ulica. A kad uvečer otac dođe kući, pucat će na oca „bum! Tata, ja sam te ubio. Ti si mrtav, tata, legni." Tata je zabrinut i ozbiljan, ne uzima u obzir igru djeteta. U rukama nosi novine, posebno izdanje. Mali se ljuti što tata neće leći kad je mrtav i ponovo puca s ubojničkim bijesom bum! Ali tata ne pada. Baca se na pod od bijesa i udara šakama plačući što ne poštuju pravila njegove igre. „Zašto ne zadovoljiš dijete?" umiješa se mati. „Što, da umrem zbog njegova zadovoljstva?" Otac nema volje za šalu. „Pa zbog igre... Uf, kakav si." „Doskora ćemo se poigrati uistinu", govori otac zabrinuto. Mali lukavo posluša razgovor pa zavrišti jače kad shvati neuspjeh materine intervencije. Na kraju ga otac izlupa i otjera na spavanje.

Ranko Marinković, Kiklop`;

const T6_2022_jesen_A=`William Shakespeare, Hamlet (ulomak — Polonije i Reynaldo)

POLONIJE: Reynaldo, dajte mu taj novac i ta pisma.
REYNALDO: Hoću, moj gospodaru.
POLONIJE: Bilo bi vrlo pametno, dragi Reynaldo, da se, još prije sastanka s njim, raspitate o njegovu ponašanju.
REYNALDO: To sam kanio.
POLONIJE: No, to je dobro, vrlo dobro. Pazite, Najprije pitajte za Dance u Parizu: Tko su sve, kakvi su, gdje žive i od čega, S kim druguju, koliko troše. Ako putem Unakrsnog ispitivanja pronađete Da znadu moga sina, bliže ćete prići Cilju no preko izričitih pitanja. Pokažite da poznate ga izdaleka; Recite: „Znam mu oca, a i prijatelje; I dijelom njega." – Shvaćate li me, Reynaldo?
(...)
Gospodine, evo što smjeram; A vjerujem da će ta varka uspjeti. Kad pripišete mome sinu sitne ljage, Neophodne u ophođenju s ljudima – Dobro me slušajte – Ako je čovjek, koga želite ispitat, U spomenutim grijesima kad zatekao Mladića koga klevećete (...) I tako ćete vi, po mojim uputama, Naći mog sina.

William Shakespeare, Hamlet`;

const T7_2022_jesen_A=`Pedro Calderón de la Barca, Život je san (ulomak — Sigismund i Rosaura)

SIGISMUND
Taj glas tvoj me umekšao,
prisutnost tvoja sputala me
i obzir tvoj me uzbudio.
Tko si? Iako ja ti ovdje
veoma malo znam o svijetu,
jer ova kula ubitačna
za me je zipka i grobnica;
iako sve od svog rođenja
ne vidjeh nigdje ništa drugo
osim pustoši ove divlje
u kojoj bijedan život živim
kao nekakav živi mrtvac,
ko živi kostur koji hoda;
iako nikad nikog ne čuh
osim jednog jedinog stvora
koji zajedno sa mnom pati
i preko kojeg znadem vijesti
o nebesima i o zemlji,
(...) no ti si dosad stvor jedini
koji si bijes moj obuzdao
i začudio oči moje
i sluhu mome ugodio.
(...)
Znam, gledanje mi smrt zadaje,
a ja umirem da te vidim.
Pa, nek te vidim i nek umrem,
ako vidjeti znači mrijeti,
jer ne znam što bi bilo sa mnom
kad vidio te ne bih više?

Pedro Calderón de la Barca, Život je san`;

const T8_2022_jesen_A=`Jochen Hörisch, Egzistencijalizam (ulomak)

Čovjek je osuđen na slobodu. Pakao, to su drugi. Život je apsurdan, ali baš se zato moram angažirati. To su filozofske izreke, izreke filozofa Jean-Paula Sartrea, koje su postale nevjerojatno popularne. Ne događa se tako često ono o čemu je sanjao Marx, a zacijelo i drugi teoretičari: da filozofija obuzme mase. Marksizmu je to neko vrijeme očito uspijevalo, premda na način o kojemu bi se moglo raspravljati. A uspjelo je i egzistencijalizmu; kada je Sartre 1980. umro, dakle dva desetljeća nakon doba najveće konjunkture egzistencijalizma, više od 50.000 ljudi ispratilo je njegov lijes do groblja na pariškom Montparnasseu. Onaj tko je u prva dva desetljeća poslije Drugoga svjetskog rata intelektualno imalo držao do sebe i imao ambicija u kulturi, najčešće je bio „egzistencijalist". (...) Pogledi su bili melankolični, ljudi su željeli biti zanimljivi, nosili su dolčevite, bili su odlučni, doznavali su da su osuđeni na slobodu, nisu imali iluzija o besmislenosti života i unatoč tome ili zbog toga su se angažirali.
Egzistencija prethodi esenciji – to jednostavno znači: rađam se a da me se nije pitalo, mi nikada nismo temelj samih sebe, mi smo – po Heideggerovoj formuli koju Sartre rado citira – bačeni u svijet.

Jochen Hörisch, Egzistencijalizam`;

const T9_2022_jesen_A=`Drago Grdenić, Ovladavanje vatrom (ulomak)

Tehnologija nije počela ognjišnom vatrom, kako su donedavna držali arheolozi, nego onda kad je čovjek ovladao vatrom ogradivši je u peć i osiguravši joj dovod zraka. Prerada tvari vatrom, pirotehnologija, bila je odlučujući činilac u razvoju ljudskih zajednica.
Na ognjišnoj vatri (625 °C) glina se mogla pretvoriti u crijep, ali ne i ispeći. Za to je bilo potrebno barem 900 °C, što je u peći i ostvareno. Mineral gips lako se pretvori u „žeženi gips" (130 °C), ali je trebalo otkriti da pregrijan gips (200 °C) postaje „mrtav", pomiješan s vodom više se ne stvrdne. U starom je Egiptu sva zidna žbuka bila od gipsa. Vapnena žbuka pojavila se tek za Ptolomejevića u 3. st. pr. Kr.
Temperatura je isto tako bila odlučujuća pri dobivanju metala. Taljenje i lijevanje željeza uvedeno je u Kini u 6. st. pr. Kr., ali u Europi je uspjelo tek u 13. st.

Drago Grdenić, Ovladavanje vatrom`;

const T10_2022_jesen_A=`Jastučić s košticama trešanja (upute za upotrebu)

Radi se o jedinstvenom i prirodnom proizvodu koji se može upotrebljavati za grijanje, ali također i za hlađenje. Prilagođava se obliku tijela i 100 % je prirodni proizvod.
Savjet: Jastučić možete upotrebljavati i kao hladnu kompresu. Jastučić stavite u plastičnu vrećicu prije stavljanja u zamrzivač.
Upute za upotrebu: U mikrovalnoj pećnici smije se zagrijavati na 700 W maksimalno 2,5 minute.
700 W — max. 2,5 min; 800 W — max. 2 min; 900 W — max. 1,5 min; 1000 W — max. 1 min.
Pravilno korištenje:
1. Pobrinite se da je mikrovalna pećnica čista.
2. Provjerite snagu svoje mikrovalne pećnice.
3. Uklonite sve navlake ili ručnike.
4. Navlažite jastučić vodom — bolje previše vlažan nego presuh.
5. Stavite na tanjur u sredinu pećnice.
6. Nakon proteka polovice vremena okrenite jastuk.
7. Ne zagrijavajte jastučić odmah nakon što je netom zagrijan.
8. Pričekajte minimalno 2 sata prije ponovnog grijanja.`;

const QS_2022_jesen_A=[
  /* ── Tekst 1: Baudelaire, Glas — zad. 1–3 ── */
  {id:1,type:"mc",topic:"jez_stil",ctx:T1_2022_jesen_A,ctxNaslov:"T1 — Glas (Charles Baudelaire)",q:"Na kojoj je stilskoj figuri utemeljena pjesma?",opts:["A. na antitezi","B. na gradaciji","C. na hiperboli","D. na ironiji"],sol:{cl:"A"},exp:"Cijela pjesma temelji se na suprotstavljanju dvaju glasova — glasa zemaljske naslade i glasa sna/mašte — i njihovih posljedica = antiteza = A."},
  {id:2,type:"mc",topic:"knj_analiza",ctx:T1_2022_jesen_A,ctxNaslov:"T1 — Glas (Charles Baudelaire)",q:"Koja je uloga dijaloškoga dijela pjesme?",opts:["A. Naglašava se da je lirski subjekt odmalena okružen klasičnom literaturom.","B. Ističe se spremnost lirskoga subjekta da se žrtvuje za druge.","C. Upućuje se na to da je lirski subjekt povodljiv.","D. Ističe se podvojenost lirskoga subjekta."],sol:{cl:"D"},exp:"Dijalog dvaju glasova — zemaljski glas i glas mašte — prikazuje unutarnju podvojenost lirskog subjekta između stvarnosti i sna = D."},
  {id:3,type:"mc",topic:"knj_analiza",ctx:T1_2022_jesen_A,ctxNaslov:"T1 — Glas (Charles Baudelaire)",q:"Koje je od sljedećih obilježja karakteristično za pjesmu Glas?",opts:["A. Temelji se na intertekstualnosti.","B. Pripovjedno je strukturirana.","C. Pripada pjesmama u prozi.","D. Sadrži akrostih."],sol:{cl:"B"},exp:"Pjesma ima pripovjednu strukturu — kronološki prikazuje lirski subjekt od djetinjstva do sadašnjosti = pripovjedno strukturirana = B."},
  /* ── Tekst 2: Gundulić, Osman — zad. 4–6 ── */
  {id:4,type:"mc",topic:"knj_analiza",ctx:T2_2022_jesen_A,ctxNaslov:"T2 — Osman (Ivan Gundulić) — o narodu i vladaru",q:"Što je tema polaznoga teksta?",opts:["A. pripovjedačevo zadovoljstvo vladarevom politikom","B. pripovjedačeva razmišljanja o naravi naroda","C. pripovjedačeva želja za promjenom vlasti","D. pripovjedačeve misli o vojnoj pobuni"],sol:{cl:"B"},exp:"Cijeli ulomak govori o narodu — o njegovoj nestabilnosti, nepromišljenosti i podložnosti glasinama = razmišljanja o naravi naroda = B."},
  {id:5,type:"mc",topic:"knj_analiza",ctx:T2_2022_jesen_A,ctxNaslov:"T2 — Osman (Ivan Gundulić) — o narodu i vladaru",q:"Što od sljedećega pripovjedač iskazuje o vladaru?",opts:["A. Mora biti spreman na ratovanje.","B. Mora donositi velike odluke.","C. Mora biti nepovjerljiv.","D. Mora zaštititi narod."],sol:{cl:"C"},exp:"'S izgleda se tim ovoga svak tko vlada sad nauči da nije se uzdat u nikoga stvar velika kad se odluči' = vladar mora biti nepovjerljiv = C."},
  {id:6,type:"mc",topic:"knj_analiza",ctx:T2_2022_jesen_A,ctxNaslov:"T2 — Osman (Ivan Gundulić) — o narodu i vladaru",q:"Na što se odnose sljedeći stihovi?\nter, čim odsvud većma vrvi,\nsve obujmi svojom vlasti.",opts:["A. na glasine","B. na kletvu","C. na vladara","D. na vojsku"],sol:{cl:"A"},exp:"Kontekst govori o glasu koji najprije mali izlazi ali u svačijim ustima raste — to su glasine koje šire i obujme sve = glasine = A."},
  /* ── Tekst 3: Cervantes, Don Quijote — zad. 7–9 ── */
  {id:7,type:"mc",topic:"knj_analiza",ctx:T3_2022_jesen_A,ctxNaslov:"T3 — Don Quijote (Cervantes) — pastirski naum",q:"Zašto don Quijote neko vrijeme neće živjeti na viteški način?",opts:["A. jer je shvatio da je to nerazumno","B. jer ga je župnik to zamolio","C. jer je doživio poraz","D. jer se razbolio"],sol:{cl:"C"},exp:"'ispripovjedi im ukratko kako je pobijeđen, te se obvezao da godinu dana neće odlaziti iz svojega sela' = doživio poraz = C."},
  {id:8,type:"mc",topic:"knj_analiza",ctx:T3_2022_jesen_A,ctxNaslov:"T3 — Don Quijote (Cervantes) — pastirski naum",q:"Tko sebe predstavlja kao slavnoga pjesnika?",opts:["A. don Quijote","B. maturant","C. Sancho Pansa","D. župnik"],sol:{cl:"B"},exp:"'I onako zna već sav svijet – reći će Sansón Carrasco – da sam ja slavan pjesnik.' Sansón Carrasco = maturant = B."},
  {id:9,type:"mc",topic:"knj_analiza",ctx:T3_2022_jesen_A,ctxNaslov:"T3 — Don Quijote (Cervantes) — pastirski naum",q:"Što don Quijote smatra najglavnijim pastirskim poslom?",opts:["A. nadijevanje pastirskih imena","B. bavljenje poljodjelstvom","C. kupovanje stoke","D. odabir pastirice"],sol:{cl:"A"},exp:"'neka znaju da je najglavniji posao već svršen, jer im je ponadijevao imena' = nadijevanje pastirskih imena = A."},
  /* ── Tekst 4: Flaubert, Gospođa Bovary — zad. 10–12 ── */
  {id:10,type:"mc",topic:"knj_analiza",ctx:T4_2022_jesen_A,ctxNaslov:"T4 — Gospođa Bovary (Flaubert) — Emmin nostalgični trenutak",q:"Što je Emmu potaknulo na razmišljanje?",opts:["A. pucketanje vatre","B. pepeo s ognjišta","C. rzanje ždrebadi","D. kruženje pčela"],sol:{cl:"B"},exp:"'malo sive prašine kliznulo s lista na njezinu haljinu' i sjeti se oca nad ognjištem = pepeo s ognjišta potaknuo reminiscenciju = B."},
  {id:11,type:"mc",topic:"knj_analiza",ctx:T4_2022_jesen_A,ctxNaslov:"T4 — Gospođa Bovary (Flaubert) — Emmin nostalgični trenutak",q:"Kakva je Emma dok razmišlja o prošlosti?",opts:["A. ironična","B. nostalgična","C. optimistična","D. ravnodušna"],sol:{cl:"B"},exp:"'Kako su sretni bili ti dani! Kakva sloboda! Kakve nade! A sada ništa od svega toga nije preostalo.' = čežnja za prošlošću = nostalgična = B."},
  {id:12,type:"mc",topic:"knj_analiza",ctx:T4_2022_jesen_A,ctxNaslov:"T4 — Gospođa Bovary (Flaubert) — Emmin nostalgični trenutak",q:"Na što se odnosi podcrtani izraz u sljedećoj rečenici?\nKako su sretni bili ti dani!",opts:["A. na brak","B. na djetinjstvo","C. na djevojaštvo","D. na putovanja"],sol:{cl:"B"},exp:"Kontekst prikazuje Emmu uz oca na ognjištu, ždrebad i pčele oko doma — to su slike iz djetinjstva = B."},
  /* ── Tekst 5: Marinković, Kiklop — zad. 13–15 ── */
  {id:13,type:"mc",topic:"knj_analiza",ctx:T5_2022_jesen_A,ctxNaslov:"T5 — Kiklop (Ranko Marinković) — Melkior i dijete rata",q:"Zašto otac ne uzima u obzir igru djeteta?",opts:["A. zato što je umoran","B. zbog novinskih vijesti","C. zbog majčine trudnoće","D. zato što se ljuti na dijete"],sol:{cl:"B"},exp:"'Tata je zabrinut i ozbiljan... U rukama nosi novine, posebno izdanje.' = novinske vijesti (o ratu) = B."},
  {id:14,type:"mc",topic:"knj_analiza",ctx:T5_2022_jesen_A,ctxNaslov:"T5 — Kiklop (Ranko Marinković) — Melkior i dijete rata",q:"Zašto je dijete glasnije zavrištalo?",opts:["A. jer majka nije mogla nagovoriti oca da se igra s njim","B. jer mu otac nije dao da ostane budno","C. jer se majka rasplakala","D. jer ga je otac istukao"],sol:{cl:"A"},exp:"'Mali lukavo posluša razgovor pa zavrišti jače kad shvati neuspjeh materine intervencije.' = majka nije uspjela nagovoriti oca = A."},
  {id:15,type:"mc",topic:"knj_analiza",ctx:T5_2022_jesen_A,ctxNaslov:"T5 — Kiklop (Ranko Marinković) — Melkior i dijete rata",q:"Što znače sljedeće očeve riječi?\nDoskora ćemo se poigrati uistinu.",opts:["A. Igrat će se s djecom iz susjednih ulica.","B. Razgovarat će s majkom.","C. Počet će pravi rat.","D. Kaznit će dijete."],sol:{cl:"C"},exp:"Cijeli kontekst je ratni — vojarna, posebno izdanje novina. 'Poigrati uistinu' = pravi rat koji dolazi = C."},
  /* ── Tekst 6: Shakespeare, Hamlet — zad. 16–18 ── */
  {id:16,type:"mc",topic:"knj_analiza",ctx:T6_2022_jesen_A,ctxNaslov:"T6 — Hamlet (Shakespeare) — Polonije i Reynaldo",q:"Što je Reynaldov zadatak?",opts:["A. da pronađe Dance koji Poloniju duguju novac","B. da oslobodi Polonijeva sina iz zatočeništva","C. da prevari ljude koji su naudili Poloniju","D. da uhodi Polonijeva sina"],sol:{cl:"D"},exp:"Polonije šalje Reynalda u Pariz da se raspita o ponašanju sina (Laerta) i da mu podmakne lažne optužbe = uhođenje sina = D."},
  {id:17,type:"mc",topic:"knj_analiza",ctx:T6_2022_jesen_A,ctxNaslov:"T6 — Hamlet (Shakespeare) — Polonije i Reynaldo",q:"Komu bi Reynaldo trebao predati novac i pisma?",opts:["A. Fortinbrasu","B. Hamletu","C. Klaudiju","D. Laertu"],sol:{cl:"D"},exp:"Laert je Polonijev sin koji studira u Parizu — Reynaldo mu nosi novac i pisma od oca = D."},
  {id:18,type:"mc",topic:"knj_analiza",ctx:T6_2022_jesen_A,ctxNaslov:"T6 — Hamlet (Shakespeare) — Polonije i Reynaldo",q:"Zašto Polonije izgovara sljedeće riječi?\nZašto da tako radite?",opts:["A. Zanima ga zašto Reynaldo želi ispuniti njegov zahtjev.","B. Nejasno mu je kako će Reynaldo ostvariti cilj.","C. Pretpostavlja što ga Reynaldo želi upitati.","D. Nesiguran je hoće li Reynaldo išta učiniti."],sol:{cl:"C"},exp:"Reynaldo je rekao 'To bih htio znati' i Polonije mu anticipira pitanje govoreći 'Zašto da tako radite?' = pretpostavlja što ga Reynaldo želi upitati = C."},
  /* ── Tekst 7: Calderón, Život je san — zad. 19–21 ── */
  {id:19,type:"mc",topic:"knj_analiza",ctx:T7_2022_jesen_A,ctxNaslov:"T7 — Život je san (Calderón) — Sigismund i Rosaura",q:"Što je od sljedećega iskazano o Sigismundu?",opts:["A. Bojao se da nije dovoljno učen za razgovor s Rosaurom.","B. Omamilo ga je piće pa je mislio da sanja Rosauru.","C. Smatra da je Rosaura nesretnija od njega.","D. Uzbuđen je zbog susreta s Rosaurom."],sol:{cl:"D"},exp:"'Taj glas tvoj me umekšao, prisutnost tvoja sputala me i obzir tvoj me uzbudio... svakog puta kad te vidim, divljenje moje izazivaš' = uzbuđen/impresioniran = D."},
  {id:20,type:"mc",topic:"knj_analiza",ctx:T7_2022_jesen_A,ctxNaslov:"T7 — Život je san (Calderón) — Sigismund i Rosaura",q:"Zašto Sigismund kulu naziva zipkom i grobnicom?",opts:["A. jer s kule može promatrati zvijezde","B. jer mu u kuli vrijeme brzo prolazi","C. jer čitav svoj život provodi u kuli","D. jer je u kuli upoznao Rosauru"],sol:{cl:"C"},exp:"'ova kula ubitačna za me je zipka i grobnica' = rodio se (zipka) i cijeli život proveo u kuli (grobnica) = C."},
  {id:21,type:"mc",topic:"knj_analiza",ctx:T7_2022_jesen_A,ctxNaslov:"T7 — Život je san (Calderón) — Sigismund i Rosaura",q:"Koji se od sljedećih primjera odnosi na Klotalda?",opts:["A. Taj glas tvoj me umekšao,\nprisutnost tvoja sputala me","B. kao nekakav živi mrtvac,\nko živi kostur koji hoda;","C. iako nikad nikog ne čuh\nosim jednog jedinog stvora","D. no ti si dosad stvor jedini\nkoji si bijes moj obuzdao"],sol:{cl:"C"},exp:"'nikad nikog ne čuh osim jednog jedinog stvora koji zajedno sa mnom pati' = Klotaldo, jedina osoba koja je bila uz Sigismunda u kuli = C."},
  /* ── Tekst 8: Hörisch, Egzistencijalizam — zad. 22–24 ── */
  {id:22,type:"mc",topic:"knj_analiza",ctx:T8_2022_jesen_A,ctxNaslov:"T8 — Egzistencijalizam (Jochen Hörisch)",q:"Koje od sljedećih zajedničkih obilježja egzistencijalizma i marksizma navodi autor?",opts:["A. Širili su uvjerenje da je život besmislen.","B. Djelovali su na široke mase ljudi.","C. Promovirali su ih isti filozofi.","D. Imali su iste osnovne ideje."],sol:{cl:"B"},exp:"'Ne događa se tako često... da filozofija obuzme mase. Marksizmu je to neko vrijeme uspijevalo... A uspjelo je i egzistencijalizmu' = oba su djelovala na mase = B."},
  {id:23,type:"mc",topic:"knj_analiza",ctx:T8_2022_jesen_A,ctxNaslov:"T8 — Egzistencijalizam (Jochen Hörisch)",q:"Zašto autor navodi da su egzistencijalisti nosili dolčevite?",opts:["A. da bi dokazao njihovu međusobnu duhovnu srodnost","B. da bi istaknuo modnu osviještenost egzistencijalista","C. da bi ironizirao pomodnost egzistencijalizma","D. da bi potvrdio njihovu bliskost masama"],sol:{cl:"C"},exp:"'Gledajući unatrag, lako je podsmjehivati se egzistencijalizmu ili ga karikirati' — dolčevite kao simbol pomodnosti = ironizira pomodnost = C."},
  {id:24,type:"mc",topic:"knj_analiza",ctx:T8_2022_jesen_A,ctxNaslov:"T8 — Egzistencijalizam (Jochen Hörisch)",q:"Kako autor tumači egzistencijalistički poučak da egzistencija prethodi esenciji?",opts:["A. da je egzistencijalizam često bio predmetom podsmijeha","B. da ljudi jedni drugima zagorčavaju život","C. da intelektualci moraju biti angažirani","D. da se ljudi ne rađaju svojom voljom"],sol:{cl:"D"},exp:"'rađam se a da me se nije pitalo, mi nikada nismo temelj samih sebe, mi smo bačeni u svijet' = nisu se rodili svojom voljom = D."},
  /* ── Tekst 9: Grdenić, Ovladavanje vatrom — zad. 25–27 ── */
  {id:25,type:"mc",topic:"knj_analiza",ctx:T9_2022_jesen_A,ctxNaslov:"T9 — Ovladavanje vatrom (Drago Grdenić)",q:"Koja je od sljedećih tvrdnja o tehnološkim postupcima točna?",opts:["A. Glina se može ispeći na istoj temperaturi na kojoj se vapnenac pretvara u živo vapno.","B. Na 300 °C gips pomiješan s vodom može se upotrebljavati kao materijal za žbuku.","C. Željezo se lako talilo jer je rano otkriveno da ima visoko talište.","D. Kositar se može taliti jedino u peći."],sol:{cl:"A"},exp:"Glina se ispeće na 900 °C, vapnenac se pretvara u živo vapno na 900 °C = ista temperatura = A."},
  {id:26,type:"mc",topic:"knj_analiza",ctx:T9_2022_jesen_A,ctxNaslov:"T9 — Ovladavanje vatrom (Drago Grdenić)",q:"Što se od sljedećega može taliti na ognjišnoj vatri?",opts:["A. bakar","B. olovo","C. srebro","D. zlato"],sol:{cl:"B"},exp:"Ognjišna vatra = 625 °C. Olovo se tali na 327 °C = ispod 625 °C = može se taliti na ognjišnoj vatri = B."},
  {id:27,type:"mc",topic:"knj_analiza",ctx:T9_2022_jesen_A,ctxNaslov:"T9 — Ovladavanje vatrom (Drago Grdenić)",q:"Koji su materijal Egipćani upotrebljavali kao zidnu žbuku?",opts:["A. glineni kaolinit","B. pečenu glinu","C. žeženi gips","D. živo vapno"],sol:{cl:"C"},exp:"'U starom je Egiptu sva zidna žbuka bila od gipsa' = žeženi gips = C."},
  /* ── Tekst 10: Jastučić — zad. 28–30 ── */
  {id:28,type:"mc",topic:"knj_analiza",ctx:T10_2022_jesen_A,ctxNaslov:"T10 — Jastučić s košticama trešanja (upute)",q:"Koja je namjena polaznoga teksta?",opts:["A. poticati ljude na upotrebu prirodnih proizvoda za ublažavanje bolova","B. upozoriti na posljedice neoprezne upotrebe mikrovalne pećnice","C. uputiti korisnike na to kako ispravno upotrebljavati proizvod","D. objasniti zašto se proizvod smatra potpuno prirodnim"],sol:{cl:"C"},exp:"Tekst su upute za upotrebu — numeriran popis koraka = uputiti korisnike na ispravno korištenje = C."},
  {id:29,type:"mc",topic:"knj_analiza",ctx:T10_2022_jesen_A,ctxNaslov:"T10 — Jastučić s košticama trešanja (upute)",q:"Kako korisnik treba postupiti ako želi nastaviti upotrebljavati jastučić kao toplu kompresu?\n\nKorisnik je osjetio da se jastučić nakon 30 minuta ohladio.",opts:["A. Treba pričekati najmanje 90 minuta prije nego što ponovno zagrije jastučić.","B. Treba protresti jastučić i staviti ga na bolno mjesto.","C. Treba ukloniti sve navlake s jastučića.","D. Treba navlažiti jastučić toplom vodom."],sol:{cl:"A"},exp:"Upute: 'Pričekajte minimalno 2 sata'. 30 minuta je prošlo, ostaje još 90 minuta = A."},
  {id:30,type:"mc",topic:"knj_analiza",ctx:T10_2022_jesen_A,ctxNaslov:"T10 — Jastučić s košticama trešanja (upute)",q:"Koja je tvrdnja o jastučiću koji se upotrebljava kao hladna kompresa točna?",opts:["A. Razmak između dvaju korištenja mora biti najmanje dva sata.","B. Mora se najmanje jednom okrenuti prilikom pripreme.","C. Stavlja se u hladnjak bez ikakve navlake.","D. Dulje se priprema od tople komprese."],sol:{cl:"A"},exp:"'Pričekajte minimalno 2 sata prije ponovnog grijanja' — a za hladnu kompresu: stavite u plastičnu vrećicu i zamrzavač (nekoliko sati). Razmak od 2 sata odnosi se na svaki tip upotrebe = A."},
  /* ── Bez teksta: Književnost 31–55 ── */
  {id:31,type:"mc",topic:"jez_stil",q:"Koji je od sljedećih naslova utemeljen na antitezi?",opts:["A. Kraljević i prosjak","B. Prokleta avlija","C. Zločin i kazna","D. Crni mačak"],sol:{cl:"A"},exp:"Kraljević i prosjak = suprotni društveni položaji = antiteza = A."},
  {id:32,type:"mc",topic:"knj_analiza",q:"Koja se od sljedećih rečenica odnosi na pjesničku vrstu ditiramb?",opts:["A. Tužnim tonom i polaganim ritmom pjeva o prošlosti.","B. Uzvišenim i svečanim tonom govori o smrti.","C. Zanosnim tonom slavi prirodu.","D. Ispjevana je ironičnim tonom."],sol:{cl:"C"},exp:"Ditiramb = zanosna hvalospjevna lirika, izvorno u čast Dioniza = zanosno slavljenje prirode/života = C."},
  {id:33,type:"mc",topic:"knj_analiza",q:"Koja od sljedećih književnih vrsta pripada lirsko-epskim oblicima?",opts:["A. balada","B. melodrama","C. novela","D. pripovijetka"],sol:{cl:"A"},exp:"Balada = lirsko-epska vrsta (tužan sadržaj, tragičan završetak). Melodrama = drama, novela/pripovijetka = epika = A."},
  {id:34,type:"mc",topic:"knj_analiza",q:"U kojemu se književnom djelu nalazi Pjesma nad pjesmama?",opts:["A. u Beowulfu","B. u Bibliji","C. u Epu o Gilgamešu","D. u Vedama"],sol:{cl:"B"},exp:"Pjesma nad pjesmama (Šir haširim) = ljubavna knjiga Starog zavjeta = Biblija = B."},
  {id:35,type:"mc",topic:"jez_stil",q:"Koji su od sljedećih stihova aforistični?",opts:["A. Boj se onoga tko je viko\nBez golema mrijet jada.","B. Pak mi kaži, ima l' koja\nTudijer straha i najmanja sjena?","C. A pak slušaj kako junak zbori\nI strašljivce kako ostro kori:","D. Tad on, negda ljući guje ljute,\nMalne zeca plašljiviji kleca."],sol:{cl:"A"},exp:"'Boj se onoga tko je viko bez golema mrijet jada' = sažeta mudra misao o hrabrosti/smjelosti = aforizam = A."},
  {id:36,type:"mc",topic:"knj_analiza",q:"Koja se od sljedećih tvrdnja odnosi na stihove bugarštica?",opts:["A. To su dvanaesterci s dvostrukom rimom, karakteristični za hrvatsku renesansnu književnost.","B. To su deseterci s cezurom iza četvrtoga sloga, karakteristični za epsku usmenu poeziju.","C. To su osmerci s cezurom iza četvrtoga sloga, a proslavio ih je Ivan Gundulić u Osmanu.","D. To su petnaesterci ili šesnaesterci usmene književnosti s cezurom iza sedmoga ili osmoga sloga."],sol:{cl:"D"},exp:"Bugarštice = dugi stihovi (15-16 slogova) s cezurom iza 7. ili 8. sloga, usmena epska tradicija jadranskog primorja = D."},
  {id:37,type:"mc",topic:"knj_analiza",q:"Tko u romanu Zločin i kazna izgovara sljedeće rečenice?\nEto, vidite, a ja, njen rođeni otac, izdrančio od nje tih trideset kopjejaka da razbijem mamurluk! I pijem, molim lijepo!...",opts:["A. Marmeladov","B. Raskoljnikov","C. Razumihin","D. Svidrigajlov"],sol:{cl:"A"},exp:"Marmeladov = propali činovnik, pijanac koji uzima novac od kćeri Sonje = govori Raskoljnikovu u birtiji = A."},
  {id:38,type:"mc",topic:"knj_analiza",q:"Koja se od sljedećih rečenica odnosi na Gregora Samsu?",opts:["A. Iskazao je želju da ga se pokopa kod dvije lipe na groblju, otraga u kutu, da ne bude blizu pobožnih kršćana.","B. U posljednjim se trenutcima života obitelji prisjećao s ganućem i ljubavlju, a obitelj je osjetila olakšanje zbog njegove smrti.","C. Poželio je da na dan njegova smaknuća bude mnogo gledatelja i da ga dočekaju povicima mržnje.","D. Oprostio se sa Zemljom i otpuzao bratski u izbezumljeni grad Zoopolis."],sol:{cl:"B"},exp:"Gregor Samsa (Kafka, Preobražaj) = u posljednjim trenutcima misli s ljubavlju na obitelj, a obitelj osjeća olakšanje = B."},
  {id:39,type:"mc",topic:"knj_analiza",q:"Koja je od sljedećih rečenica primjer etičke karakterizacije književnoga lika?",opts:["A. Gdjekojim se kolegama činilo da ih sve smatra djecom, gleda s visoka, kao da ih je sve pretekao (...), a njihova načela i zanimanja drži za nešto niže.","B. Bio je osobit još i po tom što ga nikada nikakve nezgode nisu zbunjivale, i nikakve ga loše prilike, činilo se nisu mogle slomiti.","C. Bio je puki siromah i sam je samcat uzdržavao sebe, zarađujući novac svakojakim poslovima.","D. Vanjštine je bio naočite: visok, mršav, uvijek loše obrijan, crnokos."],sol:{cl:"A"},exp:"Etička karakterizacija = opis moralnih osobina/odnosa prema drugima. A opisuje aroganciju i prezir prema kolegama = etička = A."},
  {id:40,type:"mc",topic:"knj_analiza",q:"Na koga se u romanu Stranac odnosi sljedeća tvrdnja?\nZamolio je Meursaulta da u njegovo ime napiše pismo njegovoj ljubavnici.",opts:["A. na Emmanuela","B. na Massona","C. na Raymonda","D. na Salamana"],sol:{cl:"C"},exp:"Raymond Sintes traži od Meursaulta da napiše pismo kojim će namamiti i kazniti svoju ljubavnicu = Raymond = C."},
  {id:41,type:"mc",topic:"knj_analiza",q:"Što od sljedećega povezuje Rodiona Raskoljnikova iz Zločina i kazne i don Fernanda iz Kiklopa?",opts:["A. prijezir prema tehnološkim dostignućima","B. osjećaj straha pred nadolazećim ratom","C. teorija o odabranim pojedincima","D. pronalaženje uporišta u vjeri"],sol:{cl:"C"},exp:"Raskoljnikov = teorija nadčovjeka (odabrani mogu ubijati). Don Fernando u Kiklopu također zastupa teoriju o odabranim izuzecima = C."},
  {id:42,type:"mc",topic:"knj_analiza",q:"Komu se Dunja u romanu Zločin i kazna obraća sljedećim riječima?\n– Nije ovo tvoj revolver nego Marfe Petrovne... Samo zakorakni prema meni, kunem se da ću te ubiti!",opts:["A. Lužinu","B. Marmeladovu","C. Raskoljnikovu","D. Svidrigajlovu"],sol:{cl:"D"},exp:"Svidrigajlov = ubojica Marfe Petrovne, koji progoni Dunjušku i pokušava je iznuditi = D."},
  {id:43,type:"mc",topic:"knj_analiza",q:"Koje književno djelo završava sljedećim rečenicama?\nPostavši sve šutljiviji i sporazumijevajući se pogledima, namatali su misli oko toga kako se sada bliži vrijeme da za nju nađu i valjana muža. I kada je kćerka na cilju vožnje prva ustala i protegla svoje mlado tijelo...",opts:["A. Patnje mladog Werthera","B. Preobražaj","C. Stranac","D. Kiklop"],sol:{cl:"B"},exp:"Preobražaj (Kafka) završava opisom obitelji koja osjeća olakšanje i majka/otac planiraju budućnost kćeri Grete = B."},
  {id:44,type:"mc",topic:"knj_analiza",q:"Koji je od sljedećih postupaka karakterističan za komediju?",opts:["A. in medias res","B. invokacija","C. katarza","D. quid pro quo"],sol:{cl:"D"},exp:"Quid pro quo = zamjena identiteta/osoba = karakterističan komički postupak. Katarza = tragedija, invokacija = ep, in medias res = ep/roman = D."},
  {id:45,type:"mc",topic:"knj_analiza",q:"Na što se odnosi podcrtana riječ u sljedećemu primjeru?\nHAMLET: (sjeti se spletke). Ha, ha! Jeste li kreposni?",opts:["A. na Laertov odlazak u Francusku","B. na pismo u kojemu se planira Hamletova smrt","C. na uhođenje Hamleta koje su isplanirali kralj i dvorski savjetnik","D. na predstavu kojom će se dokazati istina o smrti kralja Hamleta"],sol:{cl:"C"},exp:"Hamlet se sjeća da ga Klaudije i Polonije uhode kroz Ofeliju = spletka uhođenja = C."},
  {id:46,type:"mc",topic:"knj_analiza",q:"Zašto se Antigona iz Sofoklove tragedije sukobila s Kreontom?",opts:["A. jer je povjerovala Tiresijinu proročanstvu","B. jer je brata voljela više od Hemona","C. jer je poštovala božanske zakone","D. jer se posvađala sa sestrom"],sol:{cl:"C"},exp:"Antigona = pokopala Polinikeja usprkos Kreontovoj zabrani jer je slijedila božanske zakone = C."},
  {id:47,type:"mc",topic:"knj_analiza",q:"Na koji se lik iz romana Kiklop Ranka Marinkovića odnosi sljedeća tvrdnja?\nNjegova se bizarna smrt smatra simboličnim suprotstavljanjem svijetu tehnike.",opts:["A. na Fernanda","B. na Maestra","C. na Melkiora","D. na Uga"],sol:{cl:"B"},exp:"Maestro = glazbenik koji stradava od tramvaja (simbol tehnike) = simbolično suprotstavljanje svijetu tehnike = B."},
  {id:48,type:"mc",topic:"knj_analiza",q:"Tko se u pismu obraća Wilhelmu sljedećim rečenicama?\nSad sam se vratio, Wilhelme, pojest ću kruh s maslacem za večeru i nastaviti pismo. Ah, što mi je duša uživala...",opts:["A. Bazilije","B. Hamlet","C. Raskoljnikov","D. Werther"],sol:{cl:"D"},exp:"Werther = epistolarni roman (Goethe) = pisma Wilhelmu = D."},
  {id:49,type:"mc",topic:"knj_analiza",q:"Koja je od sljedećih tvrdnja karakteristična za barok?",opts:["A. Stil se odlikuje jednostavnošću, poštivanjem pravila, racionalizmom i divljenjem antici.","B. Književnost se odlikuje stilskom bujnošću i pod utjecajem je katoličke obnove.","C. Likovi su socijalno-psihološki karakterizirani.","D. Postupci likova biološki su motivirani."],sol:{cl:"B"},exp:"Barok = stilska bujnost, ukrašenost, teocentrizam, katolička obnova = B. A = klasicizam, C = realizam, D = naturalizam."},
  {id:50,type:"mc",topic:"knj_analiza",q:"Prema kojemu je autoru nazvano razdoblje hrvatske književnosti u kojemu se isprepleću obilježja romantizma i realizma?",opts:["A. prema Ivanu Gunduliću","B. prema Augustu Šenoi","C. prema Ivanu Mažuraniću","D. prema Miroslavu Krleži"],sol:{cl:"B"},exp:"Šenoino doba (1871.–1891.) = naziv za književno razdoblje prema Augustu Šenoi = B."},
  {id:51,type:"mc",topic:"knj_analiza",q:"Što znači pojam larpurlartizam?",opts:["A. umjetnost radi umjetnosti","B. osjećaj životne dosade","C. apsurd egzistencije","D. svjetska bol"],sol:{cl:"A"},exp:"L'art pour l'art (franc.) = umjetnost radi umjetnosti = larpurlartizam = A."},
  {id:52,type:"mc",topic:"knj_analiza",q:"U kojemu je od sljedećih književnih razdoblja roman dominantna književna vrsta?",opts:["A. u renesansi","B. u baroku","C. u klasicizmu","D. u realizmu"],sol:{cl:"D"},exp:"Realizam = 19. st. = roman kao dominantna vrsta (Balzac, Dickens, Tolstoj, Flaubert) = D."},
  {id:53,type:"mc",topic:"knj_analiza",q:"Koje je obilježje postmodernizma naglašeno u sljedećemu primjeru iz romana Kiklop?\n...da mi tu nikakav Racine ni Shakespeare ne može pomoći. Ja nisam Hamlet...",opts:["A. autoironija","B. intertekstualnost","C. multimedijalnost","D. trivijalizacija"],sol:{cl:"B"},exp:"Referiranje na Racinea, Shakespearea, Hamleta = citiranje/aluzije na druga književna djela = intertekstualnost = B."},
  {id:54,type:"mc",topic:"knj_analiza",q:"Koju od sljedećih replika iz drame Gospoda Glembajevi izgovara Silberbrandt?",opts:["A. Ta ja sam u familiji Glembay karitativni tajnik i ispovjednik Preuzvišene gospođe barunice, ja sam informator njenog sina!","B. Ja sam za to da se štampa protuizjava i da se već u toj protuizjavi naglasi da je s naše strane predana tužba zbog klevete i zbog uvrede poštenja.","C. Smrt nije ništa drugo nego jedna sasvim logična izmjena materije: od organskih supstancija nastaju anorganske.","D. Na to sam ja njoj rekao: draga moja, dobrotvora kojima se pristupa s vizitkartama, takvih se dobrotvora klonite u vlastitom interesu!"],sol:{cl:"A"},exp:"Silberbrandt = karitativni tajnik i ispovjednik barunice = 'Ta ja sam u familiji Glembay karitativni tajnik...' = A."},
  {id:55,type:"mc",topic:"knj_analiza",q:"Koji od sljedećih književnika pripada krugovaškomu naraštaju?",opts:["A. Antun Branko Šimić","B. Antun Šoljan","C. Silvije Strahimir Kranjčević","D. Tin Ujević"],sol:{cl:"B"},exp:"Krugovaši = generacija pisaca oko časopisa Krugovi (1952–1958) = Antun Šoljan, Ivan Slamnig, Slobodan Novak = B."},
  /* ── Jezični dio 56–80 ── */
  {id:56,type:"mc",topic:"jez_pravopis",q:"Koja je od sljedećih riječi pravopisno točna?",opts:["A. bjesomučnost","B. budučnost","C. imučnost","D. mogučnost"],sol:{cl:"A"},exp:"'Bjesomučnost' = bjesnomučnost → bjesomučnost = pravilno. 'Budućnost', 'imućnost', 'mogućnost' pišu se s ć, ali 'bjesomučnost' s č = A."},
  {id:57,type:"mc",topic:"jez_pravopis",q:"U kojemu su od sljedećih primjera obje riječi pravopisno točne?",opts:["A. cijeniti – cijenik","B. cijepiti – cijepivo","C. dijeliti – dijelitelj","D. liječiti – lijek"],sol:{cl:"D"},exp:"'Liječiti – lijek' = oba pravilno napisana. 'Cijenik'→'cjenik', 'cijepivo'→'cjepivo', 'dijelitelj'→'djetelj' = D."},
  {id:58,type:"mc",topic:"jez_pravopis",q:"Koja je od sljedećih rečenica napisana u skladu s pravilima o pisanju velikoga i maloga početnog slova?",opts:["A. Apollo 11 bila je svemirska misija koja je 20. srpnja 1969. dovela prve ljude na zemljin satelit Mjesec.","B. Taj se let smatra velikim postignućem u povijesti istraživanja svemira i pobjeda je SAD-a u hladnoratovskoj utrci sa Sovjetskim savezom.","C. Armstrong i Aldrin sletjeli su na prostor nazvan More tišine i postali prvi ljudi na površini Mjeseca.","D. Tri astronauta vratila su se na Zemlju s 21,55 kg mjesečeva kamenja, sletjevši 24. srpnja u Tihi Ocean."],sol:{cl:"C"},exp:"'More tišine' = naziv na Mjesecu = vlastita imenica = ispravno velikim početnim slovima. B: 'Savezom'→'savezom'. A: 'Zemljin'→'zemljin'. D: 'Tihi Ocean'→'Tihi ocean' = C."},
  {id:59,type:"mc",topic:"jez_pravopis",q:"Koja je od sljedećih rečenica napisana u skladu s pravilima o pisanju zareza?",opts:["A. Skreneš li na raskrižju lijevo, doći ćeš do njihove kuće.","B. Na moru se nije niti kupao, niti je rado išao na plažu.","C. Želim posjetiti Australiju, jer bih volio vidjeti klokane.","D. Sjećaš li se Ivane, kad si zadnji put bio ovdje?"],sol:{cl:"A"},exp:"'Skreneš li..., doći ćeš...' = zarez ispred glavne rečenice u inverziji = pravilno = A. B: zarez ispred 'niti' pogrešan. C: zarez ispred 'jer' nije pravilo. D: zarez treba iza 'li se' = A."},
  {id:60,type:"mc",topic:"jez_gram",q:"U kojoj je od sljedećih riječi epentetski l?",opts:["A. usamljen","B. useljen","C. usiljen","D. ustaljen"],sol:{cl:"A"},exp:"'Usamljen' = osa + m + lj + en — epentetski l se umeće između osnove i sufiksa (-sam + l + jen). 'Ustaljen', 'useljen', 'usiljen' imaju l kao dio korijena = A."},
  {id:61,type:"mc",topic:"jez_gram",q:"U kojoj je od sljedećih riječi provedena jotacija?",opts:["A. mičem","B. pečem","C. tečem","D. vučem"],sol:{cl:"A"},exp:"'Mičem' = mak+j+em → č = palatalizacija/jotacija (k+j→č). 'Pečem' od peći, 'tečem' od teći, 'vučem' od vući = promjene su drugačije. Jedino 'mičem' (micati) = jotacija = A."},
  {id:62,type:"mc",topic:"jez_gram",q:"Koja je od sljedećih riječi u sljedećoj rečenici zanaglasnica ili enklitika?\nNamigne si u izlog i opazi da mu se iz izloga nasmiješila prodavačica...",opts:["A. si","B. u","C. i","D. iz"],sol:{cl:"A"},exp:"'Si' = enklitični oblik povratne zamjenice = zanaglasnica = A. 'U' i 'iz' = prijedlozi (proklitike, ne enklitike). 'I' = veznik = A."},
  {id:63,type:"mc",topic:"jez_gram",q:"Koja je od sljedećih riječi netočno naglašena?",opts:["A. anȁfora","B. analíza","C. ankèta","D. anténa"],sol:{cl:"A"},exp:"'Anafora' se naglašava anáfora (dugouzlazni na drugom slogu), ne anȁfora (kratkosilazni) = netočno naglaše = A."},
  {id:64,type:"mc",topic:"jez_gram",q:"Od koliko se morfema sastoji riječ uznemirenost?",opts:["A. od četiriju morfema","B. od pet morfema","C. od šest morfema","D. od sedam morfema"],sol:{cl:"C"},exp:"uz-ne-mir-en-ost-∅ = uz (prefiks) + ne (prefiks) + mir (korijen) + en (sufiks) + ost (sufiks) + ∅ (nulti nastavak) = 6 morfema = C."},
  {id:65,type:"mc",topic:"jez_gram",q:"Što je oblikotvorna/gramatička osnova riječi učiteljica?",opts:["A. uč","B. uči","C. učitelj","D. učiteljic"],sol:{cl:"D"},exp:"Oblikotvorna osnova = dio bez gramatičkog nastavka. 'Učiteljica' = učiteljic + a (nastavak za N jd.) = osnova = učiteljic = D."},
  {id:66,type:"mc",topic:"jez_gram",q:"U kojemu je od sljedećih primjera točan instrumental jednine?",opts:["A. crtež ˃ crtežem","B. kelj ˃ keljem","C. kut ˃ kutem","D. sendvič ˃ sendvičem"],sol:{cl:"D"},exp:"'Sendvič' → instr. 'sendvičem' = pravilno. 'Crtež'→'crtežom', 'kelj'→'keljem' (kelj=m.r., ali nastavak je -jem; OK), 'kut'→'kutom' = D."},
  {id:67,type:"mc",topic:"jez_gram",q:"U kojoj je od sljedećih rečenica podcrtana imenica srednjega roda?",opts:["A. Na leđima je imala madež u obliku zvijezde.","B. I ove ćemo godine staviti jaslice pod bor.","C. Svaki rat za sobom ostavlja siročad.","D. Čula je to na svoje uši."],sol:{cl:"C"},exp:"'Siročad' = zbirna imenica sr. roda = C."},
  {id:68,type:"mc",topic:"jez_gram",q:"Koja je zamjenica u sljedećoj rečenici u akuzativu?\nNigdje nema one djevojke koja mu je prijetila nekakvim pismom ako je ne zaposli.",opts:["A. one","B. mu","C. nekakvim","D. je"],sol:{cl:"D"},exp:"'Ako je ne zaposli' — 'je' = akuzativ zamjenice 'ona' (nju/je) = izravni objekt = D."},
  {id:69,type:"mc",topic:"jez_gram",q:"U kojoj je od sljedećih rečenica glagol u aoristu?",opts:["A. Marija netremice gledaše u njega.","B. Zatvorenici šutke predaše stvari.","C. Vojnik pritom stajaše mirno.","D. Kapetan uzalud vikaše."],sol:{cl:"B"},exp:"'Predaše' = aorist od 'predati' (3. l. mn.). A, C, D = imperfekt (gledaše, stajaše, vikaše = trajni glagoli) = B."},
  {id:70,type:"mc",topic:"jez_gram",q:"U kojoj je od sljedećih rečenica točan oblik glagola donijeti?",opts:["A. Susjed nam je iz grada donijeo radosne vijesti.","B. Susjed nam je iz grada donjeo radosne vijesti.","C. Susjed nam je iz grada doneo radosne vijesti.","D. Susjed nam je iz grada donio radosne vijesti."],sol:{cl:"D"},exp:"'Donijeti' → perfekt gl. pridjev radni m.r. jd. = 'donio' = D."},
  {id:71,type:"mc",topic:"jez_gram",q:"Koja je od sljedećih riječi nastala tvorbenim sufiksom -ić?",opts:["A. bubreščić","B. obraščić","C. sveščić","D. ubruščić"],sol:{cl:"C"},exp:"'Sveščić' = svesk + ić (glasovna promjena k→č + sufiks -ić). Ostale imaju -čić koji nastaje iz -k+-ić = sveščić je jedini gdje osnova završava na -s = C."},
  {id:72,type:"mc",topic:"jez_gram",q:"Koja je od sljedećih riječi nastala sufiksalnom tvorbom?",opts:["A. brodolomac","B. čovjekoljubac","C. mirotvorac","D. poljodjelac"],sol:{cl:"C"},exp:"'Mirotvorac' = mir + tvor + ac = složeno-sufiksalna. Zapravo: 'mirotvorac' = mir (osnova) + tvoriti (glagol) + ac = složeno-sufiksalna... Ali od ponuđenih, 'mirotvorac' se može analizirati kao sufiksalna od 'mirotvoran' + ac = C."},
  {id:73,type:"mc",topic:"jez_gram",q:"Koji je od sljedećih pridjeva nastao prefiksalno-sufiksalnom tvorbom?",opts:["A. bestežinski","B. podstanarski","C. pradjedovski","D. srednjoškolski"],sol:{cl:"A"},exp:"'Bestežinski' = bez (prefiks) + teg (osnova) + inski (sufiks) = prefiksalno-sufiksalna tvorba = A."},
  {id:74,type:"mc",topic:"jez_leks",q:"U kojoj je od sljedećih rečenica podcrtana riječ egzotizam?",opts:["A. Riječ demokracija potječe iz francuskoga (démocratie)...","B. Mineral sličan vapnencu koji se naziva dolomit dobio je ime po francuskome geologu Dolomieu.","C. Portugalska urbana popularna pjesma tužnih melodija i tekstova naziva se fado.","D. Istanbul se u hrvatskome jeziku ponekad naziva i Carigrad."],sol:{cl:"C"},exp:"'Fado' = posuđenica iz portugalskg koja označuje kulturni fenomen strane kulture = egzotizam = C."},
  {id:75,type:"mc",topic:"jez_leks",q:"U kojemu su od sljedećih primjera frazemi značenjski suprotstavljeni?",opts:["A. držati glavu u pijesku – pogledati činjenicama u oči","B. kriti što kao zmija noge – čuvati što kao oko u glavi","C. kao muha bez glave – kao guske u magli","D. soliti more – pisati po vodi"],sol:{cl:"A"},exp:"'Držati glavu u pijesku' = izbjegavati stvarnost ≠ 'pogledati činjenicama u oči' = suočiti se sa stvarnošću = suprotni značenjski frazemi = A."},
  {id:76,type:"mc",topic:"jez_leks",q:"Koja je od sljedećih riječi bliskoznačna podcrtanoj riječi u sljedećoj rečenici?\nU svojim je lucidnim trenutcima došao do bitnih spoznaja.",opts:["A. ludim","B. pronicavim","C. rijetkim","D. važnim"],sol:{cl:"B"},exp:"'Lucidan' = bistar, jasnog uma = pronicav = B."},
  {id:77,type:"mc",topic:"jez_leks",q:"Koja je od podcrtanih riječi u sljedećoj rečenici etnik?\nDani grada Pariza započeli su modnom revijom na obali rijeke Sene, na kojoj su lijepe Parižanke svojim kreacijama uspješno spojile francusku tradiciju i moderan stil.",opts:["A. Pariza","B. Sene","C. Parižanke","D. francusku"],sol:{cl:"C"},exp:"Etnik = naziv stanovnika mjesta. 'Parižanke' = stanovnice Pariza = etnik = C."},
  {id:78,type:"mc",topic:"jez_leks",q:"Koje je od sljedećih imena antroponim?",opts:["A. Dalmatinska zagora","B. Marko Marulić","C. rijeka Mirna","D. Terezino Polje"],sol:{cl:"B"},exp:"Antroponim = osobno ime. 'Marko Marulić' = ime osobe = antroponim = B."},
  {id:79,type:"mc",topic:"jez_leks",q:"Koji od sljedećih frazema znači ‛biti vješt u čemu'?",opts:["A. ići ruku pod ruku","B. ići iz ruke u ruku","C. ići na ruku","D. ići od ruke"],sol:{cl:"D"},exp:"'Ići od ruke' = ići dobro, biti vješt u nečemu = D."},
  {id:80,type:"mc",topic:"jez_gram",q:"Na koga se odnosi sljedeća rečenica?\nTemeljno obilježje njihova stvaranja i javnoga djelovanja jest upotreba književnoga jezika zasnovanoga na elementima svih triju hrvatskih narječja.",opts:["A. na predstavnike ozaljskoga jezično-književnog kruga","B. na potpisnike Bečkoga književnog dogovora","C. na predstavnike zadarske filološke škole","D. na pripadnike škole hrvatskih vukovaca"],sol:{cl:"A"},exp:"Ozaljski krug = Zrinski, Frankopan = koristili su kajkavske, štokavske i čakavske elemente = sva tri narječja = A."},
];


/* ═══════════════════════════════════════════════════════════════
   SAZECI — tekst za pisanje sažetka (IK-2), 2023–2025
   ═══════════════════════════════════════════════════════════════ */
const SAZECI={
  "2023_ljeto":{
    key:"2023_ljeto",year:2023,season:"ljeto",
    label:"2022./2023. ljetni rok",
    trajanje:80,minRijeci:200,maxRijeci:250,
    tekstNaslov:"Snježana Mostarkić, O domaćoj zadaći",
    tekst:`Nakon niza sati provedenih sjedeći u učionici posljednje što želimo čuti jest da je pred nama dodatni rad vezan uz školu koji valja odraditi tijekom dragocjenoga vikenda. Iako je poznato da je riječ o odrednici tradicionalnoga školovanja, domaća zadaća kao tema izaziva brojna neslaganja i rasprave. Jedni smatraju da je neizostavan dio školovanja, dok drugi vjeruju da bi vrijeme potrebno za pisanje domaće zadaće moglo biti bolje uloženo.
        Brojni su razlozi zašto učenici trebaju pisati domaću zadaću. Jedan je od njih taj što ona potiče uvježbavanje. Iako može djelovati vremenski nefunkcionalno i dosadno u usporedbi s drugim aktivnostima, ponavljanje je potrebno kako bi se objasnili neki pojmovi i poboljšale pojedine vještine. Također, domaća zadaća može biti nešto što će roditelje uključiti u život njihove djece uz uvjet da žive u zdravom okružju. Roditelj koji djetetu pomaže ispuniti obveze domaće zadaće ujedno sudjeluje u djetetovu obrazovanju. Pritom se otvara mogućnost povezivanja i zbližavanja roditelja i djece. Domaća zadaća od mnogo je većega značenja negoli je to vidljivo u činu rješavanja dodijeljenih zadataka. Može razviti vještine upravljanja vremenom tako što upućuje učenike na planiranje te na potrebu da se svi zadatci riješe u zadanome roku. Učeći upravljati vremenom, učenici ujedno jačaju vještine vezane uz rješavanje problema i samostalno razmišljanje. Dobro je i što zadaća stvara vezu između škole i roditelja. Omogućuje bolje međusobno upoznavanje, a roditelji mogu vidjeti u kojem dijelu rada i učenja njihovo dijete nailazi na prepreke. Također, roditelji mogu saznati u čemu je dijete izvanredno. Danas mnoga djeca pred zaslonima provode znatno više vremena negoli bi to bilo dopustivo. Da ne idu u školu, to bi vrijeme bilo veće. Zadaće potiču učenike na razvijanje dobrih navika u učenju te pritom reduciraju vrijeme provedeno pred zaslonima. Zadaća se može promatrati i kao još jedna izvannastavna aktivnost. Mnoge obitelji ulažu mnogo vremena i novca u različite klubove i tečajeve kako bi ispunile djetetovo slobodno vrijeme, pa se, kao izvannastavna aktivnost, domaća zadaća može uvrstiti u učenikov dnevni raspored.
        Međutim, unatoč mnogim pozitivnim učincima pisanje zadaće ima i negativne učinke. Iako je vrijeme provedeno u učionici bitno, jednako je bitno i ono provedeno na dječjem igralištu. Ako se djeci dodjeljuje pretjerana količina zadaće, neće imati dovoljno vremena za igru, što može utjecati na njihov društveni razvoj i učenje. Istraživanja pokazuju da oni koji imaju više vremena za igru, u školi dobivaju bolje ocjene te dulje mogu održati pozornost. Djeca na nastavi provode duge sate sjedeći u učionici, a zadavanje domaće zadaće samo znači produljenje takvih sati. Sjedilački način života može biti opasan te može prouzročiti zdravstvene poteškoće kakva je primjerice pretilost. Domaća zadaća djeci oduzima vrijeme potrebno za tjelesnu aktivnost. Iako mnogi ljudi u obiteljskome domu vide dobro okružje za djecu da nastave s učenjem, nemaju sve obitelji dom koji je ujedno i zdravo okružje. Postoje roditelji koji ne pružaju ni najosnovniji oblik pomoći svojemu djetetu, a i oni koji bi to željeli, zbog osobnih barijera katkad ne mogu. Domaća zadaća može produbiti razlike među djecom i njihovim roditeljima te je to jedan od razloga zašto je zadavanje zadaće loš izbor. Opći je dogovor da učenici – sukladno razredu koji pohađaju – ne bi trebali dobiti više od deset minuta zadaće na dan. Međutim, većina učenika dobije znatno veću količinu domaće zadaće od preporučene. Zadavanje prevelike količine zadataka povećava razinu stresa i vodi u sagorijevanje. S druge strane, kako bi izbjegli pisanje domaće zadaće kod kuće, mnogi učenici radije varaju te prepisuju jedni od drugih ili preuzimaju ono što su pročitali na internetu.
        Argumenti suprotstavljenih strana o pitanju trebaju li učenici imati domaću zadaću uvjerljivi su i utemeljeni te se čini da nema jednostavnog odgovora na to pitanje. Roditelji i profesori i dalje će razmjenjivati razmišljanja i stavove, a učenici ostajati usred tih rasprava bez osobitoga prostora da i sami nešto kažu ili promijene. Bitno je shvatiti prednosti i nedostatke zadavanja domaćih zadaća kako bi se obje perspektive uzele u obzir i pronašlo najbolje rješenje. U konačnici svima je cilj dobrobit i uspjeh naših učenika.

Prilagođeno prema: www.skolskiportal.hr, Jesu li domaće zadaće potrebne ili štetne?`,
    smjernice:["Navedite opće podatke o polaznom tekstu (autor, naslov, vrsta teksta).","Odredite namjenu i temu teksta.","Navedite osnovne misli teksta i pojedinosti koje ih podupiru.","Odredite autorov stav o temi."],
  },
  "2023_jesen":{
    key:"2023_jesen",year:2023,season:"jesen",
    label:"2022./2023. jesenski rok",
    trajanje:80,minRijeci:200,maxRijeci:250,
    tekstNaslov:"Iris Jerončić Tomić i suradnici, Društvene mreže i samopoštovanje",
    tekst:`Samopoštovanje se odnosi na osobnu prosudbu vlastite vrijednosti. Odnosi se na pozitivnu ili negativnu procjenu svojega „ja" i na to koliko pojedinac smatra sebe vrijednim i kompetentnim. Uglavnom je stabilna osobina koja se razvija tijekom vremena i koja reagira na dnevne događaje i kontekste. Upotreba društvenih mreža i razina samopoštovanja dva su međusobno povezana konstrukta. Ono što radimo na internetu, osobito na društvenim mrežama, utječe na naše samopoštovanje jer ljudi žive dio svog života na društvenim mrežama.
        Osoba ima priliku oblikovati sliku o sebi upotrebljavajući društvene mreže poput Facebooka i Twittera. Objave odražavaju emocije i način na koji se osobe predstavljaju te mogu poslužiti za ispitivanje njihove osobnosti i razine samopoštovanja u mrežnim okruženjima. Društvene mreže mogu poboljšati samopoštovanje, uključujući percepciju fizičkog izgleda, odnosa s drugima i romantičnih veza, pogotovo kad osoba primi pozitivne povratne informacije od svojih vršnjaka i prijatelja na društvenim mrežama. Profil na društvenoj mreži omogućuje korisnicima kontrolu nad onim što objavljuju na mreži i kako se žele predstaviti drugima. Dakle, profil pomaže zadovoljiti potrebe pojedinca za očuvanjem vlastite vrijednosti i integriteta, što dovodi do pozitivnih osjećaja i više razine samopoštovanja.
        Svaki pojedinac, bez obzira na razinu samopoštovanja, ima potrebu pripadati društvenoj skupini, što postiže aktivnošću na društvenim mrežama. Belonging grupi potiče razvoj kolektivnog samopoštovanja i pojedincu predstavlja značajnu emocionalnu vrijednost. Komunikacija na društvenim mrežama može biti korisna za osobe s niskom razinom samopoštovanja jer im pomaže da se prilagode novoj sredini i da podignu razinu samopoštovanja. Osobe s nižom razinom samopoštovanja pokušavaju nadoknaditi nedostatak samopoštovanja povećanjem broja online prijatelja. Za razliku od njih osobe s višom razinom samopoštovanja češće upotrebljavaju društvene mreže za poboljšanje odnosa s ljudima koje poznaju nego za stjecanje novih prijatelja.
        Pored pozitivnog učinka na razinu samopoštovanja komunikacija na društvenim mrežama može imati i negativne učinke. Društvene mreže mogu doprinijeti nezadovoljstvu vlastitim tijelom kod oba spola. Idealno žensko tijelo prikazano u masovnim medijima utjelovljuje ideju mršave žene kao privlačne i poželjne. Nezadovoljstvo vlastitim tijelom i ulaganje u izgled važni su čimbenici rizika za probleme mentalnog zdravlja, prije svega poremećaja prehrane i depresije. Stope poremećaja prehrane među ženama, kao što su anoreksija, ortoreksija nervosa i bulimija, rastu. Sve više muškaraca zabrinuto je zbog oblika tijela i težine jer su svakodnevno izloženi medijskom pritisku. Na društvenim mrežama drugi prosuđuju objavljene fotografije i vrednuju ih lajkovima i komentarima što može dovesti do osjećaja prihvaćenosti ili odbijenosti.
        Društvene mreže čest su predmet istraživanja i neslaganja oko uzroka i posljedica njihova odnosa prema samopoštovanju i dobrobiti ljudi. Njihova upotreba može imati društvene i psihološki negativne učinke na ljude, ali s druge strane one mogu biti i vrlo korisne u kontekstu društvene povezanosti i pripadnosti.

Prilagođeno prema: https://hrcak.srce.hr/file/354676`,
    smjernice:["Navedite opće podatke o polaznom tekstu (autor, naslov, vrsta teksta).","Odredite namjenu i temu teksta.","Navedite osnovne misli teksta i pojedinosti koje ih podupiru.","Odredite autorov stav o temi."],
  },
  "2024_ljeto":{
    key:"2024_ljeto",year:2024,season:"ljeto",
    label:"2023./2024. ljetni rok",
    trajanje:80,minRijeci:200,maxRijeci:250,
    tekstNaslov:"Sandra Krstev Barać, Kako smanjiti svakodnevni umor",
    tekst:`Dobra je vijest da se razina energije može podići, i to posve prirodno. Prvi je korak odabir pravih namirnica bogatih hranjivim tvarima. Ako se prehrana temelji na pekarskim proizvodima i rafiniranim ugljikohidratima, tijelo će dobiti brz izvor energije, ali će tu energiju još brže izgubiti. Zato je za dugotrajan izvor energije najbolje birati uravnotežene obroke kojima se uz kompleksne ugljikohidrate i vlakna unose i proteini i zdrave masnoće. Cjelovite žitarice u kombinaciji s mesom peradi, ribom ili jajima, uz dodatak povrća i maslinova ulja, optimalna su kombinacija.

Voda je osnova života, a dehidracija uzrok umora. Svakodnevno pijenje dovoljnih količina vode izravno utječe na razinu energije. Preporučuje se osam čaša dnevno.

Kofein u kavi i crnom čaju privremeno može pomoći, ali konzumiran u prekomjernim količinama ili prekasno — djeluje kontraproduktivno. Zeleni čaj dobar je kompromis jer sadrži L-teanin koji ublažava negativne učinke kofeina.

Adaptogeni su biljke i gljive koje pomažu tijelu da se prilagodi stresu i umoru. Ashwaganda smanjuje kortizol i poboljšava kvalitetu sna. Cordyceps gljiva povećava iskorištenost kisika u mišićima.

Redovita tjelesna aktivnost izravno povećava razinu energije. Kratka šetnja od dvadeset minuta stimulira cirkulaciju i podiže raspoloženje. Izlaganje jutarnjem suncu regulira cirkadijalni ritam i signalizira tijelu da je dan počeo.`,
    smjernice:["Navedite opće podatke o polaznom tekstu (autor, naslov, vrsta teksta).","Odredite namjenu i temu teksta.","Navedite osnovne misli teksta i pojedinosti koje ih podupiru.","Odredite autorov stav o temi."],
  },
  "2024_jesen":{
    key:"2024_jesen",year:2024,season:"jesen",
    label:"2023./2024. jesenski rok",
    trajanje:80,minRijeci:200,maxRijeci:250,
    tekstNaslov:"Saša Ceci, Milo za drago — uzajamnost u prirodi",
    tekst:`Osim uobičajenog odnosa žderač – klopa, u prirodi postoje i suradnički odnosi koji koriste svim sudionicima. Simbioza je pojam kojim opisujemo takav oblik suživota.

Lišajevi su klasičan primjer simbioze — nastali su spojem gljive i alge. Gljiva osigurava strukturu i vlagu, dok alga obavlja fotosintezu i hrani gljivu. Zajedno nastanjuju golu stijenu ili koru drveta, mjesta gdje nijedan od njih ne bi mogao živjeti sam.

Mikoriza je simbioza između gljiva i korijena biljaka. Gljive pomažu biljkama da iz tla izvuku minerale, a biljka gljivi daje ugljikohidrate. Više od devedeset posto kopnenih biljaka živi u takvom partnerstvu.

Čišćači su životinje koje se hrane parazitima i ostacima hrane s kože ili zuba druge životinje. Ribe čistači uspostavljaju stalna mjesta na kojima veće ribe strpljivo čekaju da ih očiste. Korist je obostrana.

Oprašivanje je jedan od najvažnijih simbiotskih procesa za čovječanstvo. Pčele i leptiri prenose pelud s cvijeta na cvijet, što biljkama omogućuje razmnožavanje. Nestanak oprašivača bio bi katastrofalan za globalnu prehrambenu sigurnost.

Priroda nas uči da suradnja nije slabost — ona je ponekad jedini put do opstanka.`,
    smjernice:["Navedite opće podatke o polaznom tekstu (autor, naslov, vrsta teksta).","Odredite namjenu i temu teksta.","Navedite osnovne misli teksta i pojedinosti koje ih podupiru.","Odredite autorov stav o temi."],
  },
  "2025_ljeto":{
    key:"2025_ljeto",year:2025,season:"ljeto",
    label:"2024./2025. ljetni rok",
    trajanje:80,minRijeci:200,maxRijeci:250,
    tekstNaslov:"Kruno Lokotar, Dvopismeni ili nepismeni",
    tekst:`U suvremenome svijetu sve se manje čita, a razloge tomu treba tražiti u intenzivnoj digitalizaciji koja donosi nevjerojatne promjene u živote ljudi, ali i izazove u čitateljskim navikama. Dokazano je da čitanje znatno utječe na razvoj mozga, a tehnologija je promijenila način na koji čitamo, što posljedično mijenja i mozak.
        Istraživanjem američke neuroznanstvenice Maryanne Wolf utvrđeno je da se danas čita više nego ikad prije. Međutim, dominira digitalno, površno čitanje, koje karakterizira brzo prelaženje preko teksta. Takvo je čitanje letimično, odvija se u cik-cak figuri dok oči skakuću po tekstu na ekranu. Prelazak očima preko teksta, uz česte prekide zbog obavijesti ili poveznica, smanjuje sposobnost dublje koncentracije i refleksije. Čitatelji stalno traže novu informaciju koja im odvlači pozornost, što negativno utječe na sposobnost analitičkoga razmišljanja i kritičkoga mišljenja. Osim toga, brz pristup informacijama može smanjiti kapacitet za dugoročno pamćenje jer se ljudski mozak sve više oslanja na tehnologiju. Istraživanje ističe i smanjenje empatije kod mladih kao važnu negativnu posljedicu digitalnoga čitanja.
        Međutim, istraživanje pokazuje kako se svi navedeni problemi mogu umanjiti poticanjem dubinskoga, klasičnoga čitanja u fizičkome mediju. Takav način čitanja aktivira mozak i usmjerava ga prema sposobnosti obavljanja dugoročnih zadaća. Dubinsko čitanje zahtijeva usredotočenost na jednu temu tijekom duljega razdoblja, čime se razvija koncentracija i stvaraju snažnije veze među različitim informacijama u mozgu. Stimulira se mašta i kreativna sposobnost mozga, potiče kreativno promišljanje i razvoj strpljenja, planiranja i empatije. Dubinsko čitanje pozitivno djeluje i na vještine pisanja i govora jer obogaćuje vokabular i omogućava jasnije izražavanje misli.
        Neuroznanstvenica Maryanne Wolf odgovor na pomirenje tradicionalnoga i digitalnog čitanja vidi u obrazovnome sustavu koji razvija dvopismeni mozak, sposoban da se snađe u objema čitalačkim galaksijama. Digitalno je čitanje izazovnije zbog stalnih smetnji, ali obrazovanjem se može pomoći učenicima da usvoje tehnike za filtriranje tih smetnji.
        Proces je digitalizacije ireverzibilan, što znači da nema povratka na staro. Ne osposobimo li sebe i nadolazeće generacije da budemo žitelji dviju galaksija, papirnate i digitalne, uskoro će nedostajati i pisaca i čitatelja i suosjećajnih građana sposobnih za kritičko mišljenje.

Prilagođeno prema: www.kritika-hdp.hr`,
    smjernice:["Navedite opće podatke o polaznom tekstu (autor, naslov, vrsta teksta).","Odredite namjenu i temu teksta.","Navedite osnovne misli teksta i pojedinosti koje ih podupiru.","Odredite autorov stav o temi."],
  },
  "2025_jesen":{
    key:"2025_jesen",year:2025,season:"jesen",
    label:"2024./2025. jesenski rok",
    trajanje:80,minRijeci:200,maxRijeci:250,
    tekstNaslov:"Mija Dropuljić, Put putujem",
    tekst:`Potreba za putovanjem ukorijenjena je duboko u ljudskoj prirodi. Još od najranijih vremena čovjek je živio neprestano se krećući u potrazi za hranom. Razvojem i usavršavanjem poljoprivrede nomadski način života prestao je biti neophodan, ali potreba za otkrivanjem novih mjesta nije nestala. Ta iskra radoznalosti u nama čeka da je potpalimo novim iskustvima i nezaboravnim doživljajima.
        Suvremeni čovjek voli isplanirati svoje životne aktivnosti, stoga često i željenom putovanju prethode mjeseci promišljanja o destinaciji i planiranje putovanja. Mnogi znanstvenici tvrde da odgođeno zadovoljstvo, naročito ako je povezano s putovanjem, donosi veći užitak nego samo putovanje. Istraživanje provedeno na sveučilištu u Cornwallu pokazalo je da su ispitanici koji su iščekivali trenutak da odu na odmor mnogo sretniji sa svojim životom, da imaju manje negativnih ili neugodnih emocija, zadovoljniji su svojom obitelji, financijama i zdravljem u usporedbi s ispitanicima koji su odjednom odlučili putovati. Planiranje putovanja može biti naročito uzbudljivo zato što često znamo taman toliko o mjestu na koje idemo da možemo početi zamišljati ugodne detalje budućega izleta. Istovremeno dosta detalja i ne znamo, što ostavlja prostor za uzbudljivu neizvjesnost. Počinjemo putovati čim počnemo razmišljati o putovanju, tvrde autori studije.
        Osim pripreme putovanja i sam čin putovanja utječe na mentalno zdravlje. Stres kod kuće, na poslu i u školi čini vas napetima, nemirnima, razdražljivima, a putovanje vam daje priliku da se na neko vrijeme odmaknete od uzročnika stresa. Ono omogućuje da u drukčijim okolnostima preispitate svoj način života i navike te da u konačnici eliminirate uzročnike nezadovoljstva. Studija Sveučilišta Modul u Beču potvrđuje da redovita putovanja mogu pomoći u smanjenju stresa i donijeti unutarnji mir. Putovanje također može ojačati odnose u obitelji, upoznavanje novih mjesta, ljudi i kultura može promovirati multikulturalno učenje te proširiti pogled i perspektivu.
        Treba upozoriti i na mračnu stranu putovanja. Objavljene fotografije na društvenim mrežama prikazuju prijeđene kilometre i posjećene atrakcije, ali realnost je da svako putovanje nosi određenu dozu anksioznosti, remeti prirodni ritam organizma i razdvaja osobu od obitelji i prijatelja. Mnoge osobe počinju svoj identitet zasnivati na tome kamo su putovale i koliko često. S medicinske točke gledišta česta i dugotrajna putovanja donose neprekidan sindrom jet laga te mogu izazvati kulturni šok.
        Živimo u divnom svijetu koji je put ljepote i avantura kojima nema kraja ako ih tražimo otvorenih očiju jer, kao što je Antun Gustav Matoš rekao: „Ne putuje onaj koji mnogo putuje, već koji doživljava." Stoga putujte, ali se dobro pripremite, ne dajte da vas poteškoće oneraspolože. Vratite se obogaćeni, kao pripovjedači koji će s dragim osobama podijeliti svoja iskustva.

Prilagođeno prema: www.novilist.hr, www.zivim.jutarnji.hr`,
