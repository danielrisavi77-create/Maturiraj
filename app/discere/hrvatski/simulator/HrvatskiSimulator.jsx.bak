  {id:1,type:"mc",topic:"knj_analiza",ctx:T1_2016_ljeto_A,ctxNaslov:"T1 — Zemlja II. Kikiriki (Ivan Slamnig)",q:"U kojemu se stihu iskazuje da su život i smrt trajno sjedinjeni?",opts:["A. znala je savjet mi dat, gdje da posadim što,","B. travicu posij ovuda, da živica društvo imade,","C. ja se strovalih i padoh ko ono neživo tijelo,","D. kolijevka ona i lijes bili su sjeme i plod,"],sol:{cl:"D"},exp:"'Kolijevka i lijes = sjeme i plod' = život (kolijevka) i smrt (lijes) su trajno sjedinjeni = D."},
